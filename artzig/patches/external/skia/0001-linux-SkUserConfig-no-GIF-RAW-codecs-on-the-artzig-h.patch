From: Androlinzberg maintainers
Subject: [PATCH] Linux Skia: Android bitmap byte order and available codecs

Stock framework and NDK bitmap callers require RGBA bytes. Match Android
Skia's R32 shift in the library and all consumers; Mesa storage is described
separately by gralloc formats. Exclude unavailable GIF/RAW dependencies.

--- a/linux/include/config/SkUserConfig.h
+++ b/linux/include/config/SkUserConfig.h
@@ -7,9 +7,7 @@
 #define SK_CODEC_DECODES_BMP
 #endif
 
-#ifndef SK_CODEC_DECODES_GIF
-#define SK_CODEC_DECODES_GIF
-#endif
+// artzig host: GIF decoding requires unvendored wuffs.
 
 #ifndef SK_CODEC_DECODES_ICO
 #define SK_CODEC_DECODES_ICO
@@ -27,9 +25,7 @@
 #define SK_CODEC_DECODES_PNG_WITH_LIBPNG
 #endif
 
-#ifndef SK_CODEC_DECODES_RAW
-#define SK_CODEC_DECODES_RAW
-#endif
+// artzig host: RAW decoding requires unvendored dng_sdk/piex.
 
 #ifndef SK_CODEC_DECODES_WBMP
 #define SK_CODEC_DECODES_WBMP
@@ -83,12 +79,10 @@
 #define SK_GAMMA_EXPONENT 1.4
 #endif
 
-#ifndef SK_HAS_WUFFS_LIBRARY
-#define SK_HAS_WUFFS_LIBRARY
-#endif
+// artzig host: wuffs is not in the curated source closure.
 
 #ifndef SK_R32_SHIFT
-#define SK_R32_SHIFT 16
+#define SK_R32_SHIFT 0
 #endif
 
 #ifndef SK_SUPPORT_PDF
