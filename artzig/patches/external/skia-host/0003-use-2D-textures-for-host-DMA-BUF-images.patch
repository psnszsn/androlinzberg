From: Androlinzberg maintainers
Subject: [PATCH] Skia: sample host DMA-BUF imports as 2D textures

The hosted allocator exposes RGB DMA-BUF images rather than Android external
textures. Match both the Ganesh backend format and imported texture target
to the host EGL image contract, as in the existing host HWUI importer.
Android keeps its external-texture path.

--- a/src/gpu/ganesh/gl/AHardwareBufferGL.cpp
+++ b/src/gpu/ganesh/gl/AHardwareBufferGL.cpp
@@ -38,28 +38,35 @@
     if (backend != GrBackendApi::kOpenGL) {
         return GrBackendFormat();
     }
+    // Android's external texture path is not supported by desktop Ganesh.
+    // The hosted allocator imports RGB DMA-BUFs as ordinary 2D EGL images.
+#if defined(ARTZIG_HOST_GRAPHICS)
+    constexpr GrGLenum textureTarget = GR_GL_TEXTURE_2D;
+#else
+    constexpr GrGLenum textureTarget = GR_GL_TEXTURE_EXTERNAL;
+#endif
     switch (bufferFormat) {
         //TODO: find out if we can detect, which graphic buffers support GR_GL_TEXTURE_2D
         case AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM:
         case AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM:
-            return GrBackendFormats::MakeGL(GR_GL_RGBA8, GR_GL_TEXTURE_EXTERNAL);
+            return GrBackendFormats::MakeGL(GR_GL_RGBA8, textureTarget);
         case AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT:
-            return GrBackendFormats::MakeGL(GR_GL_RGBA16F, GR_GL_TEXTURE_EXTERNAL);
+            return GrBackendFormats::MakeGL(GR_GL_RGBA16F, textureTarget);
         case AHARDWAREBUFFER_FORMAT_R5G6B5_UNORM:
-            return GrBackendFormats::MakeGL(GR_GL_RGB565, GR_GL_TEXTURE_EXTERNAL);
+            return GrBackendFormats::MakeGL(GR_GL_RGB565, textureTarget);
         case AHARDWAREBUFFER_FORMAT_R10G10B10A2_UNORM:
-            return GrBackendFormats::MakeGL(GR_GL_RGB10_A2, GR_GL_TEXTURE_EXTERNAL);
+            return GrBackendFormats::MakeGL(GR_GL_RGB10_A2, textureTarget);
         case AHARDWAREBUFFER_FORMAT_R8G8B8_UNORM:
-            return GrBackendFormats::MakeGL(GR_GL_RGB8, GR_GL_TEXTURE_EXTERNAL);
+            return GrBackendFormats::MakeGL(GR_GL_RGB8, textureTarget);
 #if __ANDROID_API__ >= 33
         case AHARDWAREBUFFER_FORMAT_R8_UNORM:
-            return GrBackendFormats::MakeGL(GR_GL_R8, GR_GL_TEXTURE_EXTERNAL);
+            return GrBackendFormats::MakeGL(GR_GL_R8, textureTarget);
 #endif
         default:
             if (requireKnownFormat) {
                 return GrBackendFormat();
             } else {
-                return GrBackendFormats::MakeGL(GR_GL_RGBA8, GR_GL_TEXTURE_EXTERNAL);
+                return GrBackendFormats::MakeGL(GR_GL_RGBA8, textureTarget);
             }
     }
     SkUNREACHABLE;
@@ -144,7 +151,11 @@
         return GrBackendTexture();
     }
 
+#if defined(ARTZIG_HOST_GRAPHICS)
+    GrGLuint target = GR_GL_TEXTURE_2D;
+#else
     GrGLuint target = isRenderable ? GR_GL_TEXTURE_2D : GR_GL_TEXTURE_EXTERNAL;
+#endif
 
     glBindTexture(target, texID);
     GLenum status = GL_NO_ERROR;
