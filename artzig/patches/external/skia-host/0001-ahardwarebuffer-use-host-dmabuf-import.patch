From: Androlinzberg maintainers
Subject: [PATCH] Skia AHardwareBuffer: import host DMA-BUF storage

Reuse pinned format selection, texture binding, context invalidation and
cleanup. Mesa accepts DMA-BUFs rather than Android EGL native buffer objects,
and retains storage rather than an AHardwareBuffer reference. Hold that
reference explicitly until GLTextureHelper destruction. Protected content
remains unavailable. ARTZIG_HOST_GRAPHICS exposes these utilities without
changing Skia's Linux platform configuration or object layouts.

--- a/include/android/GrAHardwareBufferUtils.h
+++ b/include/android/GrAHardwareBufferUtils.h
@@ -9,7 +9,7 @@
 
 #include "include/core/SkTypes.h"
 
-#if defined(SK_BUILD_FOR_ANDROID) && __ANDROID_API__ >= 26
+#if (defined(SK_BUILD_FOR_ANDROID) && __ANDROID_API__ >= 26) || defined(ARTZIG_HOST_GRAPHICS)
 
 #include "include/gpu/ganesh/GrBackendSurface.h"
 #include "include/gpu/ganesh/GrTypes.h"
--- a/src/gpu/ganesh/GrAHardwareBufferUtils.cpp
+++ b/src/gpu/ganesh/GrAHardwareBufferUtils.cpp
@@ -7,7 +7,7 @@
 
 #include "include/android/GrAHardwareBufferUtils.h"
 
-#if defined(SK_BUILD_FOR_ANDROID) && __ANDROID_API__ >= 26
+#if (defined(SK_BUILD_FOR_ANDROID) && __ANDROID_API__ >= 26) || defined(ARTZIG_HOST_GRAPHICS)
 #define GL_GLEXT_PROTOTYPES
 #define EGL_EGLEXT_PROTOTYPES
 
--- a/include/android/AHardwareBufferUtils.h
+++ b/include/android/AHardwareBufferUtils.h
@@ -10,7 +10,7 @@
 #include "include/core/SkColorType.h"
 #include "include/core/SkTypes.h"
 
-#if __ANDROID_API__ >= 26
+#if __ANDROID_API__ >= 26 || defined(ARTZIG_HOST_GRAPHICS)
 
 namespace AHardwareBufferUtils {
 
--- a/src/gpu/android/AHardwareBufferUtils.cpp
+++ b/src/gpu/android/AHardwareBufferUtils.cpp
@@ -7,7 +7,7 @@
 
 #include "include/android/AHardwareBufferUtils.h"
 
-#if __ANDROID_API__ >= 26
+#if __ANDROID_API__ >= 26 || defined(ARTZIG_HOST_GRAPHICS)
 
 #include <android/hardware_buffer.h>
 
--- a/src/gpu/ganesh/gl/AHardwareBufferGL.cpp
+++ b/src/gpu/ganesh/gl/AHardwareBufferGL.cpp
@@ -7,7 +7,7 @@
 
 #include "include/android/GrAHardwareBufferUtils.h"
 
-#if defined(SK_BUILD_FOR_ANDROID) && __ANDROID_API__ >= 26
+#if (defined(SK_BUILD_FOR_ANDROID) && __ANDROID_API__ >= 26) || defined(ARTZIG_HOST_GRAPHICS)
 #define GL_GLEXT_PROTOTYPES
 #define EGL_EGLEXT_PROTOTYPES
 
@@ -20,6 +20,8 @@
 #include "src/gpu/ganesh/gl/GrGLUtil.h"
 
 #include <android/hardware_buffer.h>
+#include <vndk/hardware_buffer.h>
+#include <azk/graphics_egl.h>
 #include <EGL/egl.h>
 #include <EGL/eglext.h>
 #include <GLES/gl.h>
@@ -65,15 +67,16 @@
 
 class GLTextureHelper {
 public:
-    GLTextureHelper(GrGLuint texID, EGLImageKHR image, EGLDisplay display, GrGLuint texTarget)
+    GLTextureHelper(GrGLuint texID, EGLImageKHR image, EGLDisplay display, GrGLuint texTarget, AHardwareBuffer* buffer)
         : fTexID(texID)
         , fImage(image)
         , fDisplay(display)
-        , fTexTarget(texTarget) { }
+        , fTexTarget(texTarget), fBuffer(buffer) { AHardwareBuffer_acquire(buffer); }
     ~GLTextureHelper() {
         glDeleteTextures(1, &fTexID);
-        // eglDestroyImageKHR will remove a ref from the AHardwareBuffer
+        // Destroy Mesa storage first, then release the Android object reference.
         eglDestroyImageKHR(fDisplay, fImage);
+        AHardwareBuffer_release(fBuffer);
     }
     void rebind(GrDirectContext*);
 
@@ -82,6 +85,7 @@
     EGLImageKHR fImage;
     EGLDisplay  fDisplay;
     GrGLuint    fTexTarget;
+    AHardwareBuffer* fBuffer;
 };
 
 void GLTextureHelper::rebind(GrDirectContext* dContext) {
@@ -122,15 +126,12 @@
         bool isRenderable) {
     while (GL_NO_ERROR != glGetError()) {} //clear GL errors
 
-    EGLClientBuffer clientBuffer = eglGetNativeClientBufferANDROID(hardwareBuffer);
-    EGLint attribs[] = { EGL_IMAGE_PRESERVED_KHR, EGL_TRUE,
-                         isProtectedContent ? EGL_PROTECTED_CONTENT_EXT : EGL_NONE,
-                         isProtectedContent ? EGL_TRUE : EGL_NONE,
-                         EGL_NONE };
+    // The host owns registered DMA-BUF storage rather than Android EGL native buffers.
+    // Retain AHardwareBuffer explicitly in GLTextureHelper; Mesa retains only its storage.
+    if (isProtectedContent) return GrBackendTexture();
     EGLDisplay display = eglGetCurrentDisplay();
-    // eglCreateImageKHR will add a ref to the AHardwareBuffer
-    EGLImageKHR image = eglCreateImageKHR(display, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID,
-                                          clientBuffer, attribs);
+    EGLImageKHR image = EGL_NO_IMAGE_KHR;
+    azk_graphics_import_egl_image(display, AHardwareBuffer_getNativeHandle(hardwareBuffer), &image);
     if (EGL_NO_IMAGE_KHR == image) {
         SkDebugf("Could not create EGL image, err = (%#x)", (int) eglGetError() );
         return GrBackendTexture();
@@ -171,13 +172,13 @@
 
     *deleteProc = delete_gl_texture;
     *updateProc = update_gl_texture;
-    *imageCtx = new GLTextureHelper(texID, image, display, target);
+    *imageCtx = new GLTextureHelper(texID, image, display, target, hardwareBuffer);
 
     return GrBackendTextures::MakeGL(width, height, skgpu::Mipmapped::kNo, textureInfo);
 }
 
 static bool can_import_protected_content_eglimpl() {
-    EGLDisplay dpy = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    EGLDisplay dpy = azk_graphics_egl_display();
     const char* exts = eglQueryString(dpy, EGL_EXTENSIONS);
     size_t cropExtLen = strlen(PROT_CONTENT_EXT_STR);
     size_t extsLen = strlen(exts);
@@ -216,7 +217,7 @@
         return GrBackendTexture();
     }
 
-    if (isProtectedContent && !can_import_protected_content(dContext)) {
+    if (isProtectedContent) {
         return GrBackendTexture();
     }
 
