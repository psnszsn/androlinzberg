diff --git a/libs/hwui/renderthread/RenderProxy.cpp b/libs/hwui/renderthread/RenderProxy.cpp
index 6e6e85b4e1435f7cc80eb021afbaeacdd9cc77eb..b82fb7a627e575e87e7bb6eab836705b9f1691d3 100644
