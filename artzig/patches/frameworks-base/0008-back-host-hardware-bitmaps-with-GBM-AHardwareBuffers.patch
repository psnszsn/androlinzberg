From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 24 Aug 2026 20:15:00 +0200
Subject: [PATCH] back host hardware bitmaps with GBM AHardwareBuffers

Retain the host AHardwareBuffer inside hardware Bitmaps, return that same
allocation through Bitmap.getHardwareBuffer(), and upload or import hardware
bitmaps directly through EGL dma-buf images. Enable the existing HWUI
HardwareBufferRenderer ownership path for the Artzig host pipeline.
---
diff --git a/libs/hwui/hwui/Bitmap.cpp b/libs/hwui/hwui/Bitmap.cpp
index a6f02d94e6e5fa0bfc62d03aa181283fa0ea6fa8..9ebde74e4d1a9cad191345fe7614b39b4dc7cba3 100644
--- a/libs/hwui/hwui/Bitmap.cpp
+++ b/libs/hwui/hwui/Bitmap.cpp
@@ -241,8 +241,11 @@ sk_sp<Bitmap> Bitmap::createFrom(const SkImageInfo& info, SkPixelRef& pixelRef)
 }
 
 #ifdef ARTZIG_HOST_GPU
-sk_sp<Bitmap> Bitmap::createFrom(sk_sp<SkImage> image, BitmapPalette palette) {
-    return image ? sk_sp<Bitmap>(new Bitmap(std::move(image), palette)) : nullptr;
+sk_sp<Bitmap> Bitmap::createFrom(AHardwareBuffer* hardwareBuffer, sk_sp<SkImage> image,
+                                 BitmapPalette palette) {
+    return hardwareBuffer && image
+            ? sk_sp<Bitmap>(new Bitmap(hardwareBuffer, std::move(image), palette))
+            : nullptr;
 }
 #endif
 
@@ -374,7 +377,7 @@ Bitmap::Bitmap(AHardwareBuffer* buffer, const SkImageInfo& info, size_t rowBytes
     traceBitmapCreate();
 }
 #elif defined(ARTZIG_HOST_GPU)
-Bitmap::Bitmap(sk_sp<SkImage> image, BitmapPalette palette)
+Bitmap::Bitmap(AHardwareBuffer* buffer, sk_sp<SkImage> image, BitmapPalette palette)
         : SkPixelRef(image->width(), image->height(), nullptr, image->imageInfo().minRowBytes())
         , mInfo(validateAlpha(image->imageInfo()))
         , mPixelStorageType(PixelStorageType::Hardware)
@@ -382,7 +385,9 @@ Bitmap::Bitmap(sk_sp<SkImage> image, BitmapPalette palette)
         , mPaletteGenerationId(getGenerationID())
         , mImage(std::move(image))
         , mId(getId(mPixelStorageType)) {
+    mPixelStorage.hardware.buffer = buffer;
     mPixelStorage.hardware.size = mInfo.computeMinByteSize();
+    AHardwareBuffer_acquire(buffer);
     setImmutable();
     traceBitmapCreate();
 }
@@ -407,7 +412,7 @@ Bitmap::~Bitmap() {
 #endif
             break;
         case PixelStorageType::Hardware:
-#ifdef __ANDROID__  // Layoutlib does not support hardware acceleration
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
             auto buffer = mPixelStorage.hardware.buffer;
             AHardwareBuffer_release(buffer);
             mPixelStorage.hardware.buffer = nullptr;
@@ -478,7 +483,7 @@ void Bitmap::getBounds(SkRect* bounds) const {
     bounds->setIWH(width(), height());
 }
 
-#ifdef __ANDROID__  // Layoutlib does not support hardware acceleration
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
 AHardwareBuffer* Bitmap::hardwareBuffer() {
     if (isHardware()) {
         return mPixelStorage.hardware.buffer;
