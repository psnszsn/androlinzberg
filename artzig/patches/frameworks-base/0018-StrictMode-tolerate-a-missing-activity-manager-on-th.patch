From df5cd65eff531659f607aecd8df0c6821b1af8a0 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Wed, 2 Sep 2026 00:23:02 +0200
Subject: [PATCH] StrictMode: tolerate a missing activity manager on the artzig
 host

The unsafe-intent strict-mode callback registers with the activity manager
service; the host has none, so keep the callback process-local instead of
dereferencing null.
---
 core/java/android/os/StrictMode.java | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/core/java/android/os/StrictMode.java b/core/java/android/os/StrictMode.java
index edeb75b61..e92039a0f 100644
--- a/core/java/android/os/StrictMode.java
+++ b/core/java/android/os/StrictMode.java
@@ -2219,7 +2219,12 @@ public final class StrictMode {
         if (sUnsafeIntentCallback == null) {
             sUnsafeIntentCallback = new UnsafeIntentStrictModeCallback();
             try {
-                ActivityManager.getService().registerStrictModeCallback(sUnsafeIntentCallback);
+                // Host adaptation (artzig): there is no activity manager
+                // service to register with; keep the callback local.
+                final IActivityManager am = ActivityManager.getService();
+                if (am != null) {
+                    am.registerStrictModeCallback(sUnsafeIntentCallback);
+                }
             } catch (RemoteException e) {
                 // system_server should not throw
             }
-- 
2.55.0

