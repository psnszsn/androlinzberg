+    static sk_sp<Bitmap> createFrom(AHardwareBuffer* hardwareBuffer, sk_sp<SkColorSpace> colorSpace,
+                                    BitmapPalette palette = BitmapPalette::Unknown);
+#endif
     static sk_sp<Bitmap> createFrom(AHardwareBuffer* hardwareBuffer, sk_sp<SkImage> image,
                                     BitmapPalette palette = BitmapPalette::Unknown);
 #endif

--- a/libs/hwui/hwui/Bitmap.cpp
+++ b/libs/hwui/hwui/Bitmap.cpp
@@ -248,6 +248,17 @@
 }
 
 #ifdef ARTZIG_HOST_GPU
+#ifndef __ANDROID__
+sk_sp<Bitmap> Bitmap::createFrom(AHardwareBuffer* hardwareBuffer, sk_sp<SkColorSpace> colorSpace,
+                                 BitmapPalette palette) {
+    // Bitmap::createFrom's buffer ownership is implemented by the existing
+    // host Skia import on its owning render thread.
+    auto bitmap = uirenderer::renderthread::RenderProxy::wrapHardwareBuffer(
+            hardwareBuffer, std::move(colorSpace));
+    if (bitmap) bitmap->mPalette = palette;
+    return bitmap;
+}
+#endif
