From: Androlinzberg maintainers
Subject: [PATCH] androidfw: report the malformed child resource chunk

diff --git a/libs/androidfw/LoadedArsc.cpp b/libs/androidfw/LoadedArsc.cpp
index 7cebb6d79..687d25aad 100644
--- a/libs/androidfw/LoadedArsc.cpp
+++ b/libs/androidfw/LoadedArsc.cpp
@@ -717,7 +717,8 @@ std::unique_ptr<const LoadedPackage> LoadedPackage::Load(const Chunk& chunk,
             }
 
             default:
-              LOG(WARNING) << StringPrintf("Unknown chunk type '%02x'.", chunk.type());
+              LOG(WARNING) << StringPrintf("Unknown chunk type '%04x'.",
+                                           overlayable_child_chunk.type());
               break;
           }
         }
@@ -783,7 +784,7 @@ std::unique_ptr<const LoadedPackage> LoadedPackage::Load(const Chunk& chunk,
       } break;
 
       default:
-        LOG(WARNING) << StringPrintf("Unknown chunk type '%02x'.", chunk.type());
+        LOG(WARNING) << StringPrintf("Unknown chunk type '%04x'.", child_chunk.type());
         break;
     }
   }
@@ -868,7 +869,7 @@ bool LoadedArsc::LoadTable(const Chunk& chunk, const LoadedIdmap* loaded_idmap,
       } break;
 
       default:
-        LOG(WARNING) << StringPrintf("Unknown chunk type '%02x'.", chunk.type());
+        LOG(WARNING) << StringPrintf("Unknown chunk type '%04x'.", child_chunk.type());
         break;
     }
   }
@@ -909,7 +910,7 @@ std::unique_ptr<LoadedArsc> LoadedArsc::Load(incfs::map_ptr<void> data,
         break;
 
       default:
-        LOG(WARNING) << StringPrintf("Unknown chunk type '%02x'.", chunk.type());
+        LOG(WARNING) << StringPrintf("Unknown chunk type '%04x'.", chunk.type());
         break;
     }
   }
