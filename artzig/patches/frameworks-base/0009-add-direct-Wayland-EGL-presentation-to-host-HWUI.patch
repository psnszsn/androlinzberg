+            context, skgpu::Budgeted::kYes, bitmap->info(), 0, kTopLeft_GrSurfaceOrigin, nullptr);
+    SkBitmap intermediate;
+    if (!surface) {
+        const SkImageInfo info = bitmap->info().makeColorType(SkColorType::kN32_SkColorType);
+        surface = SkSurfaces::RenderTarget(context, skgpu::Budgeted::kYes, info, 0,
+                                           kTopLeft_GrSurfaceOrigin, nullptr);
+        if (!surface || !intermediate.tryAllocPixels(info)) {
+            return CopyResult::UnknownError;
+        }
+    }
+
+    SkPaint paint;
+    paint.setBlendMode(SkBlendMode::kSrc);
+    surface->getCanvas()->drawImageRect(
+            image, source, SkRect::MakeIWH(bitmap->width(), bitmap->height()),
+            SkSamplingOptions(SkFilterMode::kLinear), &paint, SkCanvas::kStrict_SrcRectConstraint);
+
+    bool success = surface->readPixels(*bitmap, 0, 0);
+    if (!success && intermediate.getPixels()) {
+        success = surface->readPixels(intermediate, 0, 0) &&
+                  intermediate.readPixels(bitmap->info(), bitmap->getPixels(), bitmap->rowBytes(),
+                                          0, 0);
+    }
+    if (!success) {
+        return CopyResult::UnknownError;
+    }
+    bitmap->notifyPixelsChanged();
+    return CopyResult::Success;
 }
 
