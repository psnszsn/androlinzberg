From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Mon, 24 Aug 2026 15:30:48 +0200
Subject: [PATCH 08/14] Surface: no-op setFrameRate on artzig-fake/released
 surfaces

ExoPlayer's VideoFrameReleaseHelper calls setFrameRate on the placeholder
surface after release; on a real device that logs and continues, here the
IllegalStateException spammed every player init.

Claude-Session: https://claude.ai/code/session_01VNzKg5WSGikPEYdBbYd7y4
---
 core/java/android/view/Surface.java | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/java/android/view/Surface.java b/core/java/android/view/Surface.java
index 3c1fbaecb..1ea44d510 100644
--- a/core/java/android/view/Surface.java
+++ b/core/java/android/view/Surface.java
@@ -1287,6 +1287,7 @@ public class Surface implements Parcelable {
             @FrameRateCompatibility int compatibility,
             @ChangeFrameRateStrategy int changeFrameRateStrategy) {
         synchronized (mLock) {
+            if (mArtzigFake || mNativeObject == 0) return; // artzig: fake/free surface, no-op
             checkNotReleasedLocked();
             int error = nativeSetFrameRate(mNativeObject, frameRate, compatibility,
                     changeFrameRateStrategy);
