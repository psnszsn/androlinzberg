From: Androlinzberg <host@androlinzberg.local>
Subject: [PATCH] ProtoLog: use the stock host backend and retain WM state tracing

The generated tracing flags select the original logcat backend. Keep server
diagnostics compatible with that backend without modifying ProtoLog callers.
Window state tracing remains independent.

diff --git a/services/core/java/com/android/server/wm/WindowTracing.java b/services/core/java/com/android/server/wm/WindowTracing.java
--- a/services/core/java/com/android/server/wm/WindowTracing.java
+++ b/services/core/java/com/android/server/wm/WindowTracing.java
@@ -74,7 +74,7 @@
             logAndPrintln(pw, "Error: Tracing is not supported on user builds.");
             return;
         }
-        if (!android.tracing.Flags.perfettoProtologTracing()) {
+        if (ProtoLog.getSingleInstance() instanceof LegacyProtoLogImpl) {
             ((LegacyProtoLogImpl) ProtoLog.getSingleInstance()).startProtoLog(pw);
         }
         startTraceInternal(pw);
@@ -85,7 +85,7 @@
             logAndPrintln(pw, "Error: Tracing is not supported on user builds.");
             return;
         }
-        if (!android.tracing.Flags.perfettoProtologTracing()) {
+        if (ProtoLog.getSingleInstance() instanceof LegacyProtoLogImpl) {
             ((LegacyProtoLogImpl) ProtoLog.getSingleInstance()).stopProtoLog(pw, true);
         }
         stopTraceInternal(pw);
@@ -104,7 +104,7 @@
             logAndPrintln(pw, "Error: Tracing is not supported on user builds.");
             return;
         }
-        if (!android.tracing.Flags.perfettoProtologTracing()
+        if (ProtoLog.getSingleInstance() instanceof LegacyProtoLogImpl
                 && ProtoLog.getSingleInstance().isProtoEnabled()) {
             ((LegacyProtoLogImpl) ProtoLog.getSingleInstance()).stopProtoLog(pw, true);
             ((LegacyProtoLogImpl) ProtoLog.getSingleInstance()).startProtoLog(pw);
diff --git a/services/core/java/com/android/server/wm/WindowManagerService.java b/services/core/java/com/android/server/wm/WindowManagerService.java
--- a/services/core/java/com/android/server/wm/WindowManagerService.java
+++ b/services/core/java/com/android/server/wm/WindowManagerService.java
@@ -6767,7 +6767,12 @@
             pw.println("Deprecated legacy command. Use Perfetto commands instead.");
             return;
         }
-        ((LegacyProtoLogImpl) ProtoLog.getSingleInstance()).getStatus();
+        // Unprocessed host sources use AOSP's LogcatOnlyProtoLogImpl.
+        if (ProtoLog.getSingleInstance() instanceof LegacyProtoLogImpl legacy) {
+            pw.println(legacy.getStatus());
+        } else {
+            pw.println("Logging backend: " + ProtoLog.getSingleInstance().getClass().getName());
+        }
     }
 
     private void dumpSessionsLocked(PrintWriter pw) {
