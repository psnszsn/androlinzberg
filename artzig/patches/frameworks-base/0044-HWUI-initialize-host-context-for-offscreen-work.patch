From: Androlinzberg maintainers
Subject: [PATCH] HWUI: initialize the host GPU context for offscreen work

--- a/libs/hwui/platform/host/renderthread/RenderThread.cpp
+++ b/libs/hwui/platform/host/renderthread/RenderThread.cpp
@@ -24,6 +24,7 @@
 #include <limits>
 
 #include "HostHardwareBuffer.h"
+#include "ArtzigGpuPipeline.h"
 
 #include <SkCanvas.h>
 #include <SkImage.h>
@@ -198,7 +199,15 @@
     mCacheManager = new CacheManager(*this);
 }
 
-void RenderThread::requireGlContext() {}
+void RenderThread::requireGlContext() {
+    // EglManager normally initializes offscreen work before the first window.
+    // The hosted pipeline owns that EGL/GBM context and joins existing users.
+    if (!mGrContext) {
+        auto context = skiapipeline::ArtzigGpuPipeline::ensureThreadContext(*this);
+        LOG_ALWAYS_FATAL_IF(!context, "Could not initialize the host HWUI context");
+        setGrContext(std::move(context));
+    }
+}
 
 void RenderThread::requireVkContext() {}
 
@@ -228,6 +237,7 @@
 }
 
 sk_sp<GrDirectContext> RenderThread::requireGrContext() {
+    requireGlContext();
     return mGrContext;
 }
 
@@ -328,7 +338,7 @@
 }
 
 sk_sp<Bitmap> RenderThread::allocateHardwareBitmap(SkBitmap& skBitmap) {
-    if (!mGrContext) return nullptr;
+    requireGlContext();
     uint32_t format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
     switch (skBitmap.colorType()) {
         case kRGB_565_SkColorType:
@@ -369,7 +379,8 @@
 
 sk_sp<Bitmap> RenderThread::wrapHardwareBuffer(AHardwareBuffer* buffer,
                                                sk_sp<SkColorSpace> colorSpace) {
-    if (!mGrContext || !buffer) return nullptr;
+    if (!buffer) return nullptr;
+    requireGlContext();
     sk_sp<SkImage> image = artzig::makeHardwareBufferImage(mGrContext.get(), buffer,
                                                            std::move(colorSpace));
     return Bitmap::createFrom(buffer, std::move(image), BitmapPalette::Unknown);
