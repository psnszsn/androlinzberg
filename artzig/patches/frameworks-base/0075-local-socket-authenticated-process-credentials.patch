Subject: [PATCH] LocalSocket JNI: report authenticated hosted peer credentials

Keep the original SO_PEERCRED lookup and exception behavior. Resolve known
Android process identities at the native boundary, as for Process proc queries;
unknown Linux peers retain their kernel credentials. Java clients are unchanged.

--- a/core/jni/android_net_LocalSocketImpl.cpp
+++ b/core/jni/android_net_LocalSocketImpl.cpp
@@ -39,6 +39,8 @@
 #include <netinet/tcp.h>
 #include <nativehelper/ScopedUtfChars.h>
 
+extern "C" void azk_binder_map_peer_credentials(int32_t pid, uint32_t* uid, uint32_t* gid);
+
 using android::base::ReceiveFileDescriptorVector;
 using android::base::SendFileDescriptorVector;
 
@@ -407,6 +409,7 @@
         return NULL;
     }
 
+    azk_binder_map_peer_credentials(creds.pid, &creds.uid, &creds.gid);
     return env->NewObject(class_Credentials, method_CredentialsInit,
             creds.pid, creds.uid, creds.gid);
 }
