From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Mon, 24 Aug 2026 00:26:00 +0200
Subject: [PATCH 01/14] hwui: build against stock skia m144 (nixpkgs)

- CanvasOps/RecordingCanvas/SkiaCanvas: drawPoints/drawAtlas moved to SkSpan upstream
- CanvasTransform: gradient info uses SkColor4f in m144
- MinikinSkia: SkFont getWidths/getBounds Span API
- BitmapFactory/ImageDecoder: SkCanvas ColorBehavior ctor is framework-gated and
  absent from stock libskia; the plain SkBitmap ctor is equivalent here
---
 libs/hwui/CanvasTransform.cpp   | 10 ++++++----
 libs/hwui/RecordingCanvas.cpp   | 11 +++++++----
 libs/hwui/SkiaCanvas.cpp        |  2 +-
 libs/hwui/canvas/CanvasOps.h    |  8 ++++----
 libs/hwui/hwui/ImageDecoder.cpp |  4 ++--
 libs/hwui/hwui/MinikinSkia.cpp  |  6 +++---
 libs/hwui/jni/BitmapFactory.cpp |  4 ++--
 7 files changed, 25 insertions(+), 20 deletions(-)

diff --git a/libs/hwui/CanvasTransform.cpp b/libs/hwui/CanvasTransform.cpp
index 6f60d01e4..9a6f00a99 100644
--- a/libs/hwui/CanvasTransform.cpp
+++ b/libs/hwui/CanvasTransform.cpp
@@ -92,20 +92,22 @@ static void applyColorTransform(ColorTransform transform, SkPaint& paint) {
     paint.setColor(newColor);
 
     if (paint.getShader()) {
+        // artzig: skia m144 gradient info uses SkColor4f
         SkAndroidFrameworkUtils::LinearGradientInfo info;
-        std::array<SkColor, 10> _colorStorage;
+        std::array<SkColor4f, 10> _colorStorage;
         std::array<SkScalar, _colorStorage.size()> _offsetStorage;
         info.fColorCount = _colorStorage.size();
         info.fColors = _colorStorage.data();
         info.fColorOffsets = _offsetStorage.data();
 
         if (SkAndroidFrameworkUtils::ShaderAsALinearGradient(paint.getShader(), &info) &&
-            info.fColorCount <= _colorStorage.size()) {
+            info.fColorCount <= (int)_colorStorage.size()) {
             for (int i = 0; i < info.fColorCount; i++) {
-                info.fColors[i] = transformColor(transform, info.fColors[i]);
+                info.fColors[i] = SkColor4f::FromColor(
+                        transformColor(transform, info.fColors[i].toSkColor()));
             }
             paint.setShader(SkGradientShader::MakeLinear(
-                    info.fPoints, info.fColors, info.fColorOffsets, info.fColorCount,
+                    info.fPoints, info.fColors, nullptr, info.fColorOffsets, info.fColorCount,
                     info.fTileMode, info.fGradientFlags, nullptr));
         } else {
             if (transform == ColorTransform::Invert) {
diff --git a/libs/hwui/RecordingCanvas.cpp b/libs/hwui/RecordingCanvas.cpp
index 60d7f2d14..f24261bcf 100644
--- a/libs/hwui/RecordingCanvas.cpp
+++ b/libs/hwui/RecordingCanvas.cpp
@@ -497,7 +497,7 @@ struct DrawPoints final : Op {
     SkPaint paint;
     void draw(SkCanvas* c, const SkMatrix&) const {
         if (paint.isAntiAlias()) {
-            c->drawPoints(mode, count, pod<SkPoint>(this), paint);
+            c->drawPoints(mode, SkSpan<const SkPoint>(pod<SkPoint>(this), count), paint); // artzig: m144 Span API
         } else {
             c->save();
 #ifdef __ANDROID__
@@ -506,7 +506,7 @@ struct DrawPoints final : Op {
             transform.postConcat(pixelSnap);
             c->setMatrix(transform);
 #endif
-            c->drawPoints(mode, count, pod<SkPoint>(this), paint);
+            c->drawPoints(mode, SkSpan<const SkPoint>(pod<SkPoint>(this), count), paint); // artzig: m144 Span API
             c->restore();
         }
     }
@@ -606,8 +606,11 @@ struct DrawAtlas final : Op {
         auto texs = pod<SkRect>(this, count * sizeof(SkRSXform));
         auto colors = has_colors ? pod<SkColor>(this, count * (sizeof(SkRSXform) + sizeof(SkRect)))
                                  : nullptr;
-        c->drawAtlas(atlas.get(), xforms, texs, colors, count, mode, sampling, maybe_unset(cull),
-                     &paint);
+        // artzig: m144 Span API
+        c->drawAtlas(atlas.get(), SkSpan<const SkRSXform>(xforms, count),
+                     SkSpan<const SkRect>(texs, count),
+                     colors ? SkSpan<const SkColor>(colors, count) : SkSpan<const SkColor>(),
+                     mode, sampling, maybe_unset(cull), &paint);
     }
 };
 struct DrawShadowRec final : Op {
