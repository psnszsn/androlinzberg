From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Mon, 31 Aug 2026 02:55:45 +0200
Subject: [PATCH 12/14] AssetManager: env-overridable framework-res.apk path
 for host

The artzig host installs framework-res.apk in its install tree; honor
ARTZIG_FRAMEWORK_RES (set by the launcher for every ART process) so the
system AssetManager - reached through the AOSP package parsing stack's
DefaultSplitAssetLoader - loads without a /system image.
---
 core/java/android/content/res/AssetManager.java | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/core/java/android/content/res/AssetManager.java b/core/java/android/content/res/AssetManager.java
index 008bf2f52..5ea3c95f5 100644
--- a/core/java/android/content/res/AssetManager.java
+++ b/core/java/android/content/res/AssetManager.java
@@ -220,6 +220,12 @@ public final class AssetManager implements AutoCloseable {
 
     @RavenwoodReplace
     private static String getFrameworkApkPath() {
+        // ARTZIG: the host keeps framework-res.apk in its install tree, not
+        // at the device path (same pattern as the SystemFonts env override).
+        String artzigRes = System.getenv("ARTZIG_FRAMEWORK_RES");
+        if (artzigRes != null && !artzigRes.isEmpty()) {
+            return artzigRes;
+        }
         return FRAMEWORK_APK_PATH_DEVICE;
     }
 
