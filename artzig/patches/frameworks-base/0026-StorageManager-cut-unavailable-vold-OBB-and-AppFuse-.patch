From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: artzig <artzig@localhost>
Date: Fri, 4 Sep 2026 12:00:00 +0000
Subject: [PATCH] StorageManager: cut unavailable vold, OBB and AppFuse host
 backends

The hosted system publishes the stock IStorageManager client contract over a
single emulated volume, but it has no installd/vold daemon, OBB scanner native
library, or AppFuse loop. Keep the stock client and value types while making
those unavailable daemon boundaries explicit. Constants retain their AOSP
wire values, OBB and proxy-FD setup report that they could not be queued, and
quota-project updates fail instead of linking an absent native.

diff --git a/core/java/android/os/storage/StorageManager.java b/core/java/android/os/storage/StorageManager.java
index 24f8672..df16c3d 100644
--- a/core/java/android/os/storage/StorageManager.java
+++ b/core/java/android/os/storage/StorageManager.java
@@ -56,3 +56,2 @@ import android.content.pm.PackageManager;
 import android.content.res.ObbInfo;
-import android.content.res.ObbScanner;
 import android.database.Cursor;
@@ -65,4 +64,2 @@ import android.os.Flags;
 import android.os.Handler;
-import android.os.IInstalld;
-import android.os.IVold;
 import android.os.IVoldTaskListener;
@@ -95,5 +92,2 @@ import com.android.internal.annotations.VisibleForTesting;
 import com.android.internal.logging.MetricsLogger;
-import com.android.internal.os.AppFuseMount;
-import com.android.internal.os.FuseAppLoop;
-import com.android.internal.os.FuseUnavailableMountException;
 import com.android.internal.os.RoSystemProperties;
@@ -264,9 +258,13 @@ public class StorageManager {
     /** {@hide} */
-    public static final int FLAG_STORAGE_DE = IInstalld.FLAG_STORAGE_DE;
+    public static final int FLAG_STORAGE_DE = 1 << 0;
     /** {@hide} */
-    public static final int FLAG_STORAGE_CE = IInstalld.FLAG_STORAGE_CE;
+    public static final int FLAG_STORAGE_CE = 1 << 1;
     /** {@hide} */
-    public static final int FLAG_STORAGE_EXTERNAL = IInstalld.FLAG_STORAGE_EXTERNAL;
+    public static final int FLAG_STORAGE_EXTERNAL = 1 << 2;
     /** @hide */
-    public static final int FLAG_STORAGE_SDK = IInstalld.FLAG_STORAGE_SDK;
+    public static final int FLAG_STORAGE_SDK = 1 << 3;
+
+    // Host adaptation (artzig): these are the stable IInstalld wire values. The
+    // host has no installd Binder daemon, so importing its full AIDL surface only
+    // to name these client-side flags would expose an unavailable backend.
 
@@ -295,3 +293,3 @@ public class StorageManager {
     /** {@hide} */
-    public static final int FSTRIM_FLAG_DEEP = IVold.FSTRIM_FLAG_DEEP_TRIM;
+    public static final int FSTRIM_FLAG_DEEP = 1;
 
@@ -722,13 +720,6 @@ public class StorageManager {
 
-        try {
-            final String canonicalPath = new File(rawPath).getCanonicalPath();
-            final int nonce = mObbActionListener.addListener(listener);
-            mStorageManager.mountObb(rawPath, canonicalPath, mObbActionListener, nonce,
-                    getObbInfo(canonicalPath));
-            return true;
-        } catch (IOException e) {
-            throw new IllegalArgumentException("Failed to resolve path: " + rawPath, e);
-        } catch (RemoteException e) {
-            throw e.rethrowFromSystemServer();
-        }
+        // Host adaptation (artzig): AOSP queues only after ObbScanner validates
+        // the footer. The host has neither its native scanner nor vold, so report
+        // that no operation was queued without inventing successful OBB state.
+        return false;
     }
@@ -762,11 +753,2 @@ public class StorageManager {
 
-    private ObbInfo getObbInfo(String canonicalPath) {
-        try {
-            final ObbInfo obbInfo = ObbScanner.getObbInfo(canonicalPath);
-            return obbInfo;
-        } catch (IOException e) {
-            throw new IllegalArgumentException("Couldn't get OBB info for " + canonicalPath, e);
-        }
-    }
-
     /**
@@ -1993,45 +1975,6 @@ public class StorageManager {
         MetricsLogger.count(mContext, "storage_open_proxy_file_descriptor", 1);
-        // Retry is needed because the mount point mFuseAppLoop is using may be unmounted before
-        // invoking StorageManagerService#openProxyFileDescriptor. In this case, we need to re-mount
-        // the bridge by calling mountProxyFileDescriptorBridge.
-        while (true) {
-            try {
-                synchronized (mFuseAppLoopLock) {
-                    boolean newlyCreated = false;
-                    if (mFuseAppLoop == null) {
-                        final AppFuseMount mount = mStorageManager.mountProxyFileDescriptorBridge();
-                        if (mount == null) {
-                            throw new IOException("Failed to mount proxy bridge");
-                        }
-                        mFuseAppLoop = new FuseAppLoop(mount.mountPointId, mount.fd, factory);
-                        newlyCreated = true;
-                    }
-                    if (handler == null) {
-                        handler = new Handler(Looper.getMainLooper());
-                    }
-                    try {
-                        final int fileId = mFuseAppLoop.registerCallback(callback, handler);
-                        final ParcelFileDescriptor pfd = mStorageManager.openProxyFileDescriptor(
-                                mFuseAppLoop.getMountPointId(), fileId, mode);
-                        if (pfd == null) {
-                            mFuseAppLoop.unregisterCallback(fileId);
-                            throw new FuseUnavailableMountException(
-                                    mFuseAppLoop.getMountPointId());
-                        }
-                        return pfd;
-                    } catch (FuseUnavailableMountException exception) {
-                        // The bridge is being unmounted. Tried to recreate it unless the bridge was
-                        // just created.
-                        if (newlyCreated) {
-                            throw new IOException(exception);
-                        }
-                        mFuseAppLoop = null;
-                        continue;
-                    }
-                }
-            } catch (RemoteException e) {
-                // Cannot recover from remote exception.
-                throw new IOException(e);
-            }
-        }
+        // Host adaptation (artzig): AppFuse is a vold-backed /dev/fuse loop.
+        // There is no equivalent host mount, so fail before registering a
+        // callback that can never receive I/O.
+        throw new IOException("AppFuse proxy descriptors are unavailable on the host");
     }
@@ -2079,5 +2022,3 @@ public class StorageManager {
     public int getProxyFileDescriptorMountPointId() {
-        synchronized (mFuseAppLoopLock) {
-            return mFuseAppLoop != null ? mFuseAppLoop.getMountPointId() : -1;
-        }
+        return -1;
     }
@@ -2177,3 +2118,3 @@ public class StorageManager {
     @SystemApi
-    public static final int MOUNT_MODE_EXTERNAL_NONE = IVold.REMOUNT_MODE_NONE;
+    public static final int MOUNT_MODE_EXTERNAL_NONE = 0;
     /**
@@ -2184,3 +2125,3 @@ public class StorageManager {
     @SystemApi
-    public static final int MOUNT_MODE_EXTERNAL_DEFAULT = IVold.REMOUNT_MODE_DEFAULT;
+    public static final int MOUNT_MODE_EXTERNAL_DEFAULT = 1;
     /**
@@ -2192,3 +2133,3 @@ public class StorageManager {
     @SystemApi
-    public static final int MOUNT_MODE_EXTERNAL_INSTALLER = IVold.REMOUNT_MODE_INSTALLER;
+    public static final int MOUNT_MODE_EXTERNAL_INSTALLER = 2;
     /**
@@ -2199,3 +2140,3 @@ public class StorageManager {
     @SystemApi
-    public static final int MOUNT_MODE_EXTERNAL_PASS_THROUGH = IVold.REMOUNT_MODE_PASS_THROUGH;
+    public static final int MOUNT_MODE_EXTERNAL_PASS_THROUGH = 3;
 
@@ -2209,3 +2150,3 @@ public class StorageManager {
     public static final int MOUNT_MODE_EXTERNAL_ANDROID_WRITABLE =
-            IVold.REMOUNT_MODE_ANDROID_WRITABLE;
+            4;
     /**
@@ -2569,3 +2510,8 @@ public class StorageManager {
 
-    private static native boolean setQuotaProjectId(String path, long projectId);
+    private static boolean setQuotaProjectId(String path, long projectId) {
+        // Host adaptation (artzig): AOSP delegates to vold's quotactl-backed
+        // native helper. Hosted storage has no project-quota daemon; callers
+        // receive the existing IOException failure from updateExternalStorageFileQuotaType.
+        return false;
+    }
 
@@ -3001,7 +2947,2 @@ public class StorageManager {
 
-    private final Object mFuseAppLoopLock = new Object();
-
-    @GuardedBy("mFuseAppLoopLock")
-    private @Nullable FuseAppLoop mFuseAppLoop = null;
-
     /** @hide */
