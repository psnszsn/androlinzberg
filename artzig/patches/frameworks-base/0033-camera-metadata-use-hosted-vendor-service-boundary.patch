From: Androlinzberg <host@artzig.dev>
Subject: [PATCH] camera metadata: route vendor discovery through hosted Binder

Keep native metadata allocation, validation, marshaling and parceling in AOSP.
The host uses the shared Java/NDK Binder service bridge for vendor discovery;
the Android build retains its native ICameraService proxy unchanged.

--- a/core/jni/android_hardware_camera2_CameraMetadata.cpp
+++ b/core/jni/android_hardware_camera2_CameraMetadata.cpp
@@ -35,7 +35,9 @@
 #include "core_jni_helpers.h"
 #include "android_runtime/android_hardware_camera2_CameraMetadata.h"
 
+#ifndef __ANDROID_HOST__
 #include <android/hardware/ICameraService.h>
+#endif
 #include <binder/IServiceManager.h>
 #include <camera/CameraMetadata.h>
 #include <camera_metadata_hidden.h>
@@ -936,6 +938,14 @@
     return tagType;
 }
 
+#ifdef __ANDROID_HOST__
+// The host obtains camera Binder objects through the shared Java/NDK bridge.
+// Keep camera metadata storage, parsing and marshaling in this original JNI.
+extern jint azk_camera_setup_vendor_tags(JNIEnv* env);
+static jint CameraMetadata_setupGlobalVendorTagDescriptor(JNIEnv *env, jclass) {
+    return azk_camera_setup_vendor_tags(env);
+}
+#else
 static jint CameraMetadata_setupGlobalVendorTagDescriptor(JNIEnv *env, jclass thiz) {
     const String16 NAME("media.camera");
     sp<hardware::ICameraService> cameraService;
@@ -984,5 +994,6 @@
     }
     return OK;
 }
+#endif
 
 } // extern "C"
