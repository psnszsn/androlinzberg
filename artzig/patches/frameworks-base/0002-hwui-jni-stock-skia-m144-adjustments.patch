+        result = matrix->setPolyToPoly(SkSpan<const SkPoint>((const SkPoint*) src, ptCount),
+                SkSpan<const SkPoint>((const SkPoint*) dst, ptCount)); // artzig: m144 Span API
         return result ? JNI_TRUE : JNI_FALSE;
     }
 
