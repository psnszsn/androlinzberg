diff --git a/core/java/android/view/Surface.java b/core/java/android/view/Surface.java
index 6e6e87bb..09165955 100644
--- a/core/java/android/view/Surface.java
+++ b/core/java/android/view/Surface.java
@@ -380,16 +380,18 @@ public class Surface implements Parcelable {
      * @throws OutOfResourcesException if the surface could not be created.
      */
     public Surface(SurfaceTexture surfaceTexture) {
+        // artzig: no native GL consumer — a fake, always-"valid" surface used
+        // only as a token (e.g. ExoPlayer's PlaceholderSurface).
         if (surfaceTexture == null) {
             throw new IllegalArgumentException("surfaceTexture must not be null");
         }
-        mIsSingleBuffered = surfaceTexture.isSingleBuffered();
+        mIsSingleBuffered = false;
         synchronized (mLock) {
             mName = surfaceTexture.toString();
-            setNativeObjectLocked(nativeCreateFromSurfaceTexture(surfaceTexture));
+            mArtzigFake = true;
         }
-        registerNativeMemoryUsage();
     }
+    private boolean mArtzigFake;
 
     /* called from android_view_Surface_createFromIGraphicBufferProducer() */
     @UnsupportedAppUsage(maxTargetSdk = Build.VERSION_CODES.R, trackingBug = 170729553)
@@ -420,6 +422,7 @@ public class Surface implements Parcelable {
      */
     public void release() {
         synchronized (mLock) {
+            if (mArtzigFake) { mArtzigFake = false; return; }
             if (mHwuiContext != null) {
                 mHwuiContext.destroy();
                 mHwuiContext = null;
@@ -467,6 +470,7 @@ public class Surface implements Parcelable {
      */
     public boolean isValid() {
         synchronized (mLock) {
+            if (mArtzigFake) return true;
             if (mNativeObject == 0) return false;
             return nativeIsValid(mNativeObject);
         }
diff --git a/core/java/android/widget/Toast.java b/core/java/android/widget/Toast.java
index ead8887f..c6b8628d 100644
--- a/core/java/android/widget/Toast.java
+++ b/core/java/android/widget/Toast.java
@@ -205,6 +205,11 @@ public class Toast {
         }
 
         INotificationManager service = getService();
+        if (service == null) {
+            // artzig: no notification service — log the toast instead of showing it
+            Log.i(TAG, "Toast (dropped): " + mText);
+            return;
+        }
         String pkg = mContext.getOpPackageName();
         TN tn = mTN;
         if (Flags.toastNoWeakref()) {
@@ -254,7 +259,9 @@ public class Toast {
         if (Compatibility.isChangeEnabled(CHANGE_TEXT_TOASTS_IN_THE_SYSTEM)
                 && mNextView == null) {
             try {
-                getService().cancelToast(mContext.getOpPackageName(), mToken);
+                if (getService() != null) {
+                    getService().cancelToast(mContext.getOpPackageName(), mToken);
+                }
             } catch (RemoteException e) {
                 // Empty
             }
