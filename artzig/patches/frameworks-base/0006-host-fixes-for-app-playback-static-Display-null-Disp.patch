         SkPath* obj = reinterpret_cast<SkPath*>(objHandle);
-        return static_cast<int>(obj->getFillType());
+        int ft = static_cast<int>(obj->getFillType());
+        if (ft < 0 || ft > 3) {
+            ALOGW("azk getFillType garbage: handle=%p ft=%d", (void*)objHandle, ft);
+            ft = 0;
+        }
+        return ft;
     }
 
     static void setFillType(CRITICAL_JNI_PARAMS_COMMA jlong pathHandle, jint ftHandle) {;
