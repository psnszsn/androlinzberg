From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Fri, 4 Sep 2026 20:08:00 +0000
Subject: [PATCH 24/25] WindowOrganizer: tolerate host SurfaceControl apply-token
 boundary

The hosted SurfaceControl is a fenced SurfaceFlinger adaptation and therefore
does not expose Transaction.setDefaultApplyToken, whose stock implementation
is a native SurfaceFlinger call. Keep WindowOrganizer stock-compatible when
that API exists, but discover it reflectively so the transport/type client can
compile on the host. An absent method means sharing the queue is unavailable,
which matches this method's existing false failure result.
---
 core/java/android/window/WindowOrganizer.java | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/core/java/android/window/WindowOrganizer.java b/core/java/android/window/WindowOrganizer.java
--- a/core/java/android/window/WindowOrganizer.java
+++ b/core/java/android/window/WindowOrganizer.java
@@ -183,6 +183,15 @@ public class WindowOrganizer {
         if (wmApplyToken == null) {
             return false;
         }
-        SurfaceControl.Transaction.setDefaultApplyToken(wmApplyToken);
+        try {
+            SurfaceControl.Transaction.class
+                    .getMethod("setDefaultApplyToken", IBinder.class)
+                    .invoke(null, wmApplyToken);
+        } catch (NoSuchMethodException e) {
+            // The hosted SurfaceControl has no SurfaceFlinger apply-token queue.
+            return false;
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException("Unable to share the transaction queue", e);
+        }
         return true;
     }
