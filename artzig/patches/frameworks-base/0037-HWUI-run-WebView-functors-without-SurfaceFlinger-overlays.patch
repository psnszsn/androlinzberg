From: artzig <artzig@localhost>
Subject: [PATCH] HWUI: reuse WebView callbacks without SurfaceFlinger overlays

Keep AOSP functor ownership, callback ordering and GL drawing on the host.
SurfaceControl overlays require SurfaceFlinger; report them disabled so the
provider draws into the existing HWUI EGL canvas instead.

--- a/libs/hwui/WebViewFunctorManager.cpp
+++ b/libs/hwui/WebViewFunctorManager.cpp
@@ -16,7 +16,9 @@
 
 #include "WebViewFunctorManager.h"
 
+#ifdef __ANDROID__
 #include <gui/SurfaceComposerClient.h>
+#endif
 #include <log/log.h>
 #include <private/hwui/WebViewFunctor.h>
 #include <utils/Trace.h>
@@ -106,9 +108,11 @@
     destroyContext();
 
     ATRACE_NAME("WebViewFunctor::onDestroy");
+#ifdef __ANDROID__
     if (mSurfaceControl) {
         removeOverlays();
     }
+#endif
     mCallbacks.onDestroyed(mFunctor, mData);
 }
 
@@ -119,12 +123,15 @@
 
 void WebViewFunctor::onRemovedFromTree() {
     ATRACE_NAME("WebViewFunctor::onRemovedFromTree");
+#ifdef __ANDROID__
     if (mSurfaceControl) {
         removeOverlays();
     }
+#endif
 }
 
 bool WebViewFunctor::prepareRootSurfaceControl() {
+#ifdef __ANDROID__
     if (!Properties::enableWebViewOverlays) return false;
 
     renderthread::CanvasContext* activeContext = renderthread::CanvasContext::getActiveContext();
@@ -140,6 +147,9 @@
     }
 
     return true;
+#else
+    return false;
+#endif
 }
 
 void WebViewFunctor::drawGl(const DrawGlInfo& drawInfo) {
@@ -207,15 +217,20 @@
 }
 
 void WebViewFunctor::removeOverlays() {
+#ifdef __ANDROID__
     ScopedCurrentFunctor currentFunctor(this);
     mCallbacks.removeOverlays(mFunctor, mData, currentFunctor.mergeTransaction);
     if (mSurfaceControl) {
         reparentSurfaceControl(nullptr);
         mSurfaceControl = nullptr;
     }
+#else
+
+#endif
 }
 
 ASurfaceControl* WebViewFunctor::getSurfaceControl() {
+#ifdef __ANDROID__
     ATRACE_NAME("WebViewFunctor::getSurfaceControl");
     if (mSurfaceControl != nullptr) {
         return reinterpret_cast<ASurfaceControl*>(mSurfaceControl.get());
@@ -240,9 +255,13 @@
     SurfaceComposerClient::Transaction transaction;
     transaction.setLayer(mSurfaceControl, -1).show(mSurfaceControl).apply();
     return reinterpret_cast<ASurfaceControl*>(mSurfaceControl.get());
+#else
+    return nullptr;
+#endif
 }
 
 void WebViewFunctor::mergeTransaction(ASurfaceTransaction* transaction) {
+#ifdef __ANDROID__
     ATRACE_NAME("WebViewFunctor::mergeTransaction");
     if (transaction == nullptr) return;
     bool done = false;
@@ -254,9 +273,13 @@
     if (!done) {
         reinterpret_cast<SurfaceComposerClient::Transaction*>(transaction)->apply();
     }
+#else
+    LOG_ALWAYS_FATAL_IF(transaction != nullptr, "SurfaceControl overlays are unavailable on the host");
+#endif
 }
 
 void WebViewFunctor::reparentSurfaceControl(ASurfaceControl* parent) {
+#ifdef __ANDROID__
     ATRACE_NAME("WebViewFunctor::reparentSurfaceControl");
     if (mSurfaceControl == nullptr) return;
 
@@ -264,6 +287,9 @@
     transaction.reparent(mSurfaceControl, sp<SurfaceControl>::fromExisting(
                                                   reinterpret_cast<SurfaceControl*>(parent)));
     mergeTransaction(reinterpret_cast<ASurfaceTransaction*>(&transaction));
+#else
+    LOG_ALWAYS_FATAL_IF(parent != nullptr, "SurfaceControl overlays are unavailable on the host");
+#endif
 }
 
 void WebViewFunctor::reportRenderingThreads(const pid_t* thread_ids, size_t size) {
--- a/libs/hwui/pipeline/skia/SkiaRecordingCanvas.cpp
+++ b/libs/hwui/pipeline/skia/SkiaRecordingCanvas.cpp
@@ -38,8 +38,10 @@
 #include "RenderNode.h"
 #include "pipeline/skia/AnimatedDrawables.h"
 #include "pipeline/skia/BackdropFilterDrawable.h"
-#ifdef __ANDROID__ // Layoutlib does not support GL, Vulcan etc.
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
 #include "pipeline/skia/GLFunctorDrawable.h"
+#endif
+#ifdef __ANDROID__
 #include "pipeline/skia/VkFunctorDrawable.h"
 #include "pipeline/skia/VkInteropFunctorDrawable.h"
 #endif
@@ -186,11 +188,14 @@
 }
 
 void SkiaRecordingCanvas::drawWebViewFunctor(int functor) {
-#ifdef __ANDROID__ // Layoutlib does not support GL, Vulcan etc.
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
     FunctorDrawable* functorDrawable;
+#ifdef __ANDROID__
     if (Properties::getRenderPipelineType() == RenderPipelineType::SkiaVulkan) {
         functorDrawable = mDisplayList->allocateDrawable<VkFunctorDrawable>(functor, asSkCanvas());
-    } else {
+    } else
+#endif
+    {
         functorDrawable = mDisplayList->allocateDrawable<GLFunctorDrawable>(functor, asSkCanvas());
     }
     mDisplayList->mChildFunctors.push_back(functorDrawable);
