From 1b98fb4693242265561f774e1248ed46eab151a4 Mon Sep 17 00:00:00 2001
From: artzig <artzig@localhost>
Date: Wed, 2 Sep 2026 16:04:52 +0200
Subject: [PATCH] ApplicationLoaders: the system class loader is the base
 parent on the artzig host

The framework rides the app classpath here (there is no boot classpath
image), so app and shared-library class loaders must resolve android.*
through the system class loader rather than its boot parent.

Change-Id: I049c002a7be47cb9c223a978281c6fc059eef054
---
 core/java/android/app/ApplicationLoaders.java | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/core/java/android/app/ApplicationLoaders.java b/core/java/android/app/ApplicationLoaders.java
index 9cd99dca1..4bb5b2015 100644
--- a/core/java/android/app/ApplicationLoaders.java
+++ b/core/java/android/app/ApplicationLoaders.java
@@ -103,7 +103,10 @@ public class ApplicationLoaders {
          * don't use that and can happily (and more efficiently) use the
          * bootstrap class loader.
          */
-        ClassLoader baseParent = ClassLoader.getSystemClassLoader().getParent();
+        // Host adaptation (artzig): the framework rides the app classpath (no
+        // boot classpath), so the parent every app and shared-library loader
+        // resolves android.* through is the system class loader itself.
+        ClassLoader baseParent = ClassLoader.getSystemClassLoader();
 
         synchronized (mLoaders) {
             if (parent == null) {
-- 
