+    /**
+     * The pure-Java portion of NetworkUtilsInternal.isWeaklyValidatedHostname. Keeping it here
+     * avoids importing that class's process-networking JNI, which has no hosted VPN counterpart.
+     */
+    private static boolean isWeaklyValidatedHostname(String hostname) {
+        if (!hostname.matches("^[a-zA-Z0-9_.-]+$")) {
+            return false;
+        }
+        return android.system.Os.inet_pton(android.system.OsConstants.AF_INET, hostname) == null
+                && android.system.Os.inet_pton(android.system.OsConstants.AF_INET6, hostname) == null;
+    }
+
