From 6bb7794b61f4d3b1651b2670eccd8777b6127c74 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Tue, 1 Sep 2026 23:13:43 +0200
Subject: [PATCH] MessageQueue: host pump slice for the Wayland owner loop
 (artzig)

Host adaptation: the hosted main looper is driven by the compositor loop, not
by blocking in nativePollOnce, so the Combined queue gains a bounded,
non-blocking slice of nextLegacy() -- pollDueMessage$artzig (barrier-aware,
also a zero-timeout native poll so fd listeners are serviced),
nextPollDelayMillis$artzig, runIdleHandlers$artzig (once per idle transition),
wakeHost$artzig, and recycleDispatched$artzig for the pump's messages. Every
hosted process uses the legacy queue, which this slice walks.
---
 .../os/CombinedMessageQueue/MessageQueue.java | 147 ++++++++++++++++++
 1 file changed, 147 insertions(+)

diff --git a/core/java/android/os/CombinedMessageQueue/MessageQueue.java b/core/java/android/os/CombinedMessageQueue/MessageQueue.java
index e7181ac84..ec4583422 100644
--- a/core/java/android/os/CombinedMessageQueue/MessageQueue.java
+++ b/core/java/android/os/CombinedMessageQueue/MessageQueue.java
@@ -141,6 +141,14 @@ public final class MessageQueue {
         if (sIsProcessAllowedToUseConcurrent != null) {
             return;
         }
+        // Host adaptation (artzig): the hosted main looper is driven by the
+        // Wayland owner loop through the bounded pump below, which walks the
+        // legacy message list; every hosted process therefore uses the legacy
+        // queue regardless of uid/process name.
+        sIsProcessAllowedToUseConcurrent = false;
+        if (sIsProcessAllowedToUseConcurrent != null) {
+            return;
+        }
 
         // Holdback study.
         if (Flags.messageQueueForceLegacy()) {
@@ -1018,6 +1026,145 @@ public final class MessageQueue {
             publicAlternatives =
                     "To manipulate the queue in Instrumentation tests, use {@link"
                         + " android.os.TestLooperManager}")
+
+    // ---------------------------------------------------------------------
+    // Host adaptation (artzig): a bounded, non-blocking slice of nextLegacy()
+    // for the Wayland owner loop (dev.artzig.ApkHost.pumpMainLooper). Android's
+    // main looper blocks in nativePollOnce; the host instead polls this queue's
+    // epoll descriptor alongside the compositor and drains due work in slices.
+    // The idle-handler pass keeps next()'s "once per idle transition" contract:
+    // handlers run after work was dispatched and the queue went idle again.
+    // ---------------------------------------------------------------------
+
+    private boolean mIdleHandlersPending$artzig = true;
+
+    /**
+     * Returns one due message (honoring sync barriers) or null when nothing is
+     * due yet. Also drains the native wake and dispatches ready file-descriptor
+     * listeners, exactly as a zero-timeout poll in next() would.
+     */
+    public Message pollDueMessage$artzig() {
+        final long ptr = mPtr;
+        if (ptr == 0) {
+            return null;
+        }
+        nativePollOnce(ptr, 0);
+        synchronized (this) {
+            final long now = SystemClock.uptimeMillis();
+            Message prevMsg = null;
+            Message msg = mMessages;
+            if (msg != null && msg.target == null) {
+                // Stalled by a barrier. Find the next asynchronous message.
+                do {
+                    prevMsg = msg;
+                    msg = msg.next;
+                } while (msg != null && !msg.isAsynchronous());
+            }
+            if (msg == null || now < msg.when) {
+                if (mQuitting) {
+                    dispose();
+                }
+                return null;
+            }
+            mBlocked = false;
+            if (prevMsg != null) {
+                prevMsg.next = msg.next;
+                if (prevMsg.next == null) {
+                    mLast = prevMsg;
+                }
+            } else {
+                mMessages = msg.next;
+                if (msg.next == null) {
+                    mLast = null;
+                }
+            }
+            msg.next = null;
+            msg.markInUse();
+            if (msg.isAsynchronous()) {
+                mAsyncMessageCount--;
+            }
+            decAndTraceMessageCount();
+            mIdleHandlersPending$artzig = true;
+            return msg;
+        }
+    }
+
+    /** Milliseconds until the next deliverable message, 0 if due, -1 if none. */
+    public long nextPollDelayMillis$artzig() {
+        synchronized (this) {
+            if (mQuitting) {
+                return -1;
+            }
+            Message msg = mMessages;
+            if (msg != null && msg.target == null) {
+                do {
+                    msg = msg.next;
+                } while (msg != null && !msg.isAsynchronous());
+            }
+            if (msg == null) {
+                return -1;
+            }
+            return Math.max(0L, msg.when - SystemClock.uptimeMillis());
+        }
+    }
+
+    /** Runs the idle handlers once after the queue has gone idle following work. */
+    public void runIdleHandlers$artzig() {
+        final IdleHandler[] pending;
+        final int count;
+        synchronized (this) {
+            if (!mIdleHandlersPending$artzig || mQuitting) {
+                return;
+            }
+            final long now = SystemClock.uptimeMillis();
+            if (mMessages != null && now >= mMessages.when) {
+                return; // not idle yet
+            }
+            mIdleHandlersPending$artzig = false;
+            count = mIdleHandlers.size();
+            if (count == 0) {
+                return;
+            }
+            if (mPendingIdleHandlers == null) {
+                mPendingIdleHandlers = new IdleHandler[Math.max(count, 4)];
+            }
+            mPendingIdleHandlers = mIdleHandlers.toArray(mPendingIdleHandlers);
+            pending = mPendingIdleHandlers;
+        }
+        for (int i = 0; i < count; i++) {
+            final IdleHandler idler = pending[i];
+            pending[i] = null; // release the reference to the handler
+            boolean keep = false;
+            try {
+                keep = idler.queueIdle();
+            } catch (Throwable t) {
+                Log.wtf(TAG_L, "IdleHandler threw exception", t);
+            }
+            if (!keep) {
+                synchronized (this) {
+                    mIdleHandlers.remove(idler);
+                }
+            }
+        }
+    }
+
+    /**
+     * Recycles a message the host pump dispatched. A dequeued message is marked
+     * in use until Looper.loopOnce recycles it with the package-private
+     * recycleUnchecked; the pump lives outside android.os, so this is its way in.
+     */
+    public static void recycleDispatched$artzig(Message msg) {
+        msg.recycleUnchecked();
+    }
+
+    /** Wakes the host loop so it re-enters the pump (bounded-slice rescheduling). */
+    public void wakeHost$artzig() {
+        final long ptr = mPtr;
+        if (ptr != 0) {
+            nativeWake(ptr);
+        }
+    }
+
     Message next() {
         if (mUseConcurrent) {
             return nextConcurrent();
-- 
