From: Androlinzberg host integration
Subject: [PATCH] Environment: hosted persistent and session data roots

ANDROID_DATA still supplies ART's cache while ARTZIG_DATA_DIR owns persistent
application data. System policy uses ARTZIG_SYSTEM_DATA_DIR because broker UIDs
are session-local. This remaining Java adaptation belongs to the runtime/data
partition batch; SQLiteGlobal now resolves its stock /data probe below Java.

diff --git a/core/java/android/os/Environment.java b/core/java/android/os/Environment.java
index 69540c42a..1ad2d0672 100644
--- a/core/java/android/os/Environment.java
+++ b/core/java/android/os/Environment.java
@@ -98,7 +98,13 @@ public class Environment {
     public static final String DIRECTORY_ANDROID = DIR_ANDROID;
 
     private static final File DIR_ANDROID_ROOT = getDirectory(ENV_ANDROID_ROOT, "/system");
-    private static final String DIR_ANDROID_DATA_PATH = getDirectoryPath(ENV_ANDROID_DATA, "/data");
+    // Host adaptation (artzig): ANDROID_DATA is ART's dalvik-cache root here
+    // (an XDG cache directory shared between sessions), so the session's data
+    // root, which the launcher exports as ARTZIG_DATA_DIR, takes precedence.
+    private static final String DIR_ANDROID_DATA_PATH =
+            getDirectoryPath("ARTZIG_DATA_DIR", getDirectoryPath(ENV_ANDROID_DATA, "/data"));
     private static final File DIR_ANDROID_DATA = new File(DIR_ANDROID_DATA_PATH);
+    private static final File DIR_ANDROID_SYSTEM_DATA =
+            getDirectory("ARTZIG_SYSTEM_DATA_DIR", DIR_ANDROID_DATA_PATH);
     private static final File DIR_ANDROID_EXPAND = getDirectory(ENV_ANDROID_EXPAND, "/mnt/expand");
     private static final File DIR_ANDROID_STORAGE = getDirectory(ENV_ANDROID_STORAGE, "/storage");
@@ -410,3 +410,3 @@
     public static File getDataSystemDirectory() {
-        return new File(getDataDirectory(), "system");
+        return new File(DIR_ANDROID_SYSTEM_DATA, "system");
     }
@@ -420,3 +420,3 @@
     public static @NonNull File getDataSystemDeviceProtectedDirectory() {
-        return buildPath(getDataDirectory(), "system_de");
+        return buildPath(DIR_ANDROID_SYSTEM_DATA, "system_de");
     }
@@ -428,3 +428,3 @@
     public static @NonNull File getDataSystemDeDirectory() {
-        return buildPath(getDataDirectory(), "system_de");
+        return buildPath(DIR_ANDROID_SYSTEM_DATA, "system_de");
     }
@@ -436,3 +436,3 @@
     public static File getDataSystemCeDirectory() {
-        return buildPath(getDataDirectory(), "system_ce");
+        return buildPath(DIR_ANDROID_SYSTEM_DATA, "system_ce");
     }
@@ -456,3 +456,3 @@
     public static File getDataSystemCeDirectory(int userId) {
-        return buildPath(getDataDirectory(), "system_ce", String.valueOf(userId));
+        return buildPath(DIR_ANDROID_SYSTEM_DATA, "system_ce", String.valueOf(userId));
     }
@@ -476,3 +476,3 @@
     public static File getDataSystemDeDirectory(int userId) {
-        return buildPath(getDataDirectory(), "system_de", String.valueOf(userId));
+        return buildPath(DIR_ANDROID_SYSTEM_DATA, "system_de", String.valueOf(userId));
     }
