From: Androlinzberg host integration
Subject: [PATCH] ATMS: complete host permission operations through stock results

--- a/services/core/java/com/android/server/wm/ActivityStarter.java
+++ b/services/core/java/com/android/server/wm/ActivityStarter.java
@@ -1377,6 +1377,18 @@
             return START_ABORTED;
         }
 
+        // The host permission endpoint returns administrator-managed state without
+        // a standalone PermissionController APK. Retain stock authorization and
+        // result delivery before creating any activity/task/transition for it.
+        final Integer hostResult = HostedActivityOperations.complete(aInfo, intent, caller,
+                callingUid, callingPid, callingPackage,
+                resultRecord == null ? null : resultRecord.token, resultWho, requestCode,
+                balVerdict.allows() || mService.isBackgroundActivityStartsEnabled());
+        if (hostResult != null) {
+            ActivityOptions.abort(checkedOptions);
+            return hostResult;
+        }
+
         // If permissions need a review before any of the app components can run, we
         // launch the review activity and pass a pending intent to start the activity
         // we are to launching now after the review is completed.
