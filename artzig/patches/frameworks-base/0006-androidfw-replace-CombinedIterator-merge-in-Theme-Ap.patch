 .../hardware/input/InputGestureData.java      | 20 +++++-
 .../input/KeyboardLayoutPreviewDrawable.java  | 23 +++++-
 .../hardware/input/PhysicalKeyLayout.java     | 46 +++++++++++-
 libs/androidfw/AssetManager2.cpp              | 31 ++++----
 libs/hwui/hwui/ImageDecoder.cpp               |  5 ++
 6 files changed, 161 insertions(+), 34 deletions(-)

