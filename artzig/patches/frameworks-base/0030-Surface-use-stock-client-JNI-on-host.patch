From: Androlinzberg maintainers
Subject: [PATCH] Surface: use stock client JNI over host libgui

Enable the platform Surface and Parcel operations for the source-built host
libgui. JNI owns the actual Surface/BLAST objects and GraphicBuffer lifetime.
HardwareRenderer resolves the same stock ANativeWindow_fromSurface entry.

--- a/core/jni/android_view_Surface.cpp
+++ b/core/jni/android_view_Surface.cpp
@@ -28,7 +28,7 @@
 #include <android_runtime/android_graphics_SurfaceTexture.h>
 #include <android_runtime/android_view_Surface.h>
 #include <android_runtime/Log.h>
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
 #include <private/android/AHardwareBufferHelpers.h>
 
 #include "android_os_Parcel.h"
@@ -37,7 +37,7 @@
 #include <gui/BLASTBufferQueue.h>
 #endif
 #include <gui/Surface.h>
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
 #include <gui/SurfaceControl.h>
 #include <gui/view/Surface.h>
 #endif
@@ -72,7 +72,7 @@
     jfieldID bottom;
 } gRectClassInfo;
 
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
 class JNamedColorSpace {
 public:
     // ColorSpace.Named.SRGB.ordinal() = 0;
@@ -151,7 +151,7 @@
 
 // ----------------------------------------------------------------------------
 
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
 static jlong nativeCreateFromSurfaceTexture(JNIEnv* env, jclass clazz,
         jobject surfaceTextureObj) {
     sp<IGraphicBufferProducer> producer(SurfaceTexture_getProducer(env, surfaceTextureObj));
@@ -278,7 +278,7 @@
 }
 
 // ----------------------------------------------------------------------------
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
 static jlong nativeCreateFromSurfaceControl(JNIEnv* env, jclass clazz,
         jlong surfaceControlNativeObj) {
     sp<SurfaceControl> ctrl(reinterpret_cast<SurfaceControl *>(surfaceControlNativeObj));
@@ -422,7 +422,7 @@
     return surface->disconnect(-1, IGraphicBufferProducer::DisconnectMode::AllLocal);
 }
 
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
 static jint nativeAttachAndQueueBufferWithColorSpace(JNIEnv* env, jclass clazz, jlong nativeObject,
                                                      jobject hardwareBuffer, jint colorSpaceId) {
     Surface* surface = reinterpret_cast<Surface*>(nativeObject);
@@ -469,7 +469,7 @@
 // ----------------------------------------------------------------------------
 
 static const JNINativeMethod gSurfaceMethods[] = {
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
         {"nativeCreateFromSurfaceTexture", "(Landroid/graphics/SurfaceTexture;)J",
          (void*)nativeCreateFromSurfaceTexture},
 #endif
@@ -481,7 +481,7 @@
         {"nativeUnlockCanvasAndPost", "(JLandroid/graphics/Canvas;)V",
          (void*)nativeUnlockCanvasAndPost},
         {"nativeAllocateBuffers", "(J)V", (void*)nativeAllocateBuffers},
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
         {"nativeCreateFromSurfaceControl", "(J)J", (void*)nativeCreateFromSurfaceControl},
         {"nativeGetFromSurfaceControl", "(JJ)J", (void*)nativeGetFromSurfaceControl},
         {"nativeReadFromParcel", "(JLandroid/os/Parcel;)J", (void*)nativeReadFromParcel},
@@ -492,14 +492,14 @@
         {"nativeGetNextFrameNumber", "(J)J", (void*)nativeGetNextFrameNumber},
         {"nativeSetScalingMode", "(JI)I", (void*)nativeSetScalingMode},
         {"nativeForceScopedDisconnect", "(J)I", (void*)nativeForceScopedDisconnect},
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
         {"nativeAttachAndQueueBufferWithColorSpace", "(JLandroid/hardware/HardwareBuffer;I)I",
          (void*)nativeAttachAndQueueBufferWithColorSpace},
 #endif
         {"nativeSetSharedBufferModeEnabled", "(JZ)I", (void*)nativeSetSharedBufferModeEnabled},
         {"nativeSetAutoRefreshEnabled", "(JZ)I", (void*)nativeSetAutoRefreshEnabled},
         {"nativeSetFrameRate", "(JFII)I", (void*)nativeSetFrameRate},
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
         {"nativeGetFromBlastBufferQueue", "(JJ)J", (void*)nativeGetFromBlastBufferQueue},
 #endif
         {"nativeDestroy", "(J)V", (void*)nativeDestroy},
--- a/libs/hwui/jni/android_graphics_HardwareRenderer.cpp
+++ b/libs/hwui/jni/android_graphics_HardwareRenderer.cpp
@@ -17,6 +17,7 @@
 #define ATRACE_TAG ATRACE_TAG_VIEW
 
 #include <FrameInfo.h>
+#include <android/native_window_jni.h>
 #include <GraphicsJNI.h>
 #include <Picture.h>
 #include <Properties.h>
@@ -1131,9 +1132,8 @@
             GetMethodIDOrDie(env, copyRequest, "getDestinationBitmap", "(II)J");
 
 #ifdef ARTZIG_HOST_GPU
-    // artzig supplies its native target directly to RenderProxy. Java Surface
-    // objects are not used by this host renderer.
-    fromSurface = [](JNIEnv*, jobject) -> ANativeWindow* { return nullptr; };
+    // The host links the stock Surface JNI into this same native island.
+    fromSurface = ANativeWindow_fromSurface;
 #elif defined(__ANDROID__)
     void* handle_ = SharedLib::openSharedLib("libandroid");
 #else
