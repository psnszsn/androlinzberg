From: Androlinzberg host integration
Subject: [PATCH] ToneGenerator JNI: retain volume conversion at host audio seam

Keep the pinned tone descriptors, synthesizer and lifecycle. Native AudioTrack
requires AudioFlinger; use the existing hosted PCM output at its boundary.

--- a/core/jni/android_media_ToneGenerator.cpp
+++ b/core/jni/android_media_ToneGenerator.cpp
@@ -96,7 +96,11 @@
     ALOGV("%s jobject: %p", __func__, thiz);
     ScopedUtfChars opPackageNameStr{env, opPackageName};
     sp<ToneGenerator> lpToneGen = sp<ToneGenerator>::make((audio_stream_type_t)streamType,
+#ifdef ARTZIG_HOST_AUDIO
+                                    artzig::ToneOutput::linearToLog(volume),
+#else
                                     AudioSystem::linearToLog(volume),
+#endif
                                     true /*threadCanCallJava*/,
                                     opPackageNameStr.c_str());
     if (!lpToneGen->isInited()) {
