diff --git a/libs/hwui/platform/host/renderthread/RenderThread.cpp b/libs/hwui/platform/host/renderthread/RenderThread.cpp
index d7aabe525..54e4575f9 100644
--- a/libs/hwui/platform/host/renderthread/RenderThread.cpp
+++ b/libs/hwui/platform/host/renderthread/RenderThread.cpp
@@ -16,7 +16,11 @@
 
 #include "renderthread/RenderThread.h"
 
+#include "HostHardwareBuffer.h"
+
+#include <SkCanvas.h>
 #include <SkImage.h>
+#include <SkSurface.h>
 #include <include/gpu/ganesh/SkImageGanesh.h>
 #include <unistd.h>
 
@@ -133,12 +137,50 @@ void RenderThread::pushBackFrameCallback(IFrameCallback* callback) {}
 
 sk_sp<Bitmap> RenderThread::allocateHardwareBitmap(SkBitmap& skBitmap) {
     if (!mGrContext) return nullptr;
-    sk_sp<SkImage> raster = SkImages::RasterFromPixmapCopy(skBitmap.pixmap());
-    if (!raster) return nullptr;
-    sk_sp<SkImage> texture = SkImages::TextureFromImage(mGrContext.get(), raster);
-    if (!texture) return nullptr;
-    mGrContext->flushAndSubmit(texture);
-    return Bitmap::createFrom(std::move(texture), Bitmap::computePalette(skBitmap));
+    uint32_t format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
+    switch (skBitmap.colorType()) {
+        case kRGB_565_SkColorType:
+            format = AHARDWAREBUFFER_FORMAT_R5G6B5_UNORM;
+            break;
+        case kRGBA_F16_SkColorType:
+            format = AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT;
+            break;
+        case kRGBA_1010102_SkColorType:
+            format = AHARDWAREBUFFER_FORMAT_R10G10B10A2_UNORM;
+            break;
+        default:
+            break;
+    }
+    AHardwareBuffer_Desc description{};
+    description.width = skBitmap.width();
+    description.height = skBitmap.height();
+    description.layers = 1;
+    description.format = format;
+    description.usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+                        AHARDWAREBUFFER_USAGE_GPU_COLOR_OUTPUT;
+    AHardwareBuffer* buffer = nullptr;
+    if (AHardwareBuffer_allocate(&description, &buffer) != 0) return nullptr;
+
+    sk_sp<SkSurface> surface = artzig::makeHardwareBufferSurface(
+            mGrContext.get(), buffer, sk_ref_sp(skBitmap.colorSpace()));
+    if (!surface || !surface->getCanvas()->writePixels(skBitmap, 0, 0)) {
+        AHardwareBuffer_release(buffer);
+        return nullptr;
+    }
+    mGrContext->flushAndSubmit(surface.get(), GrSyncCpu::kNo);
+    sk_sp<SkImage> image = surface->makeImageSnapshot();
+    sk_sp<Bitmap> bitmap = Bitmap::createFrom(buffer, std::move(image),
+                                              Bitmap::computePalette(skBitmap));
+    AHardwareBuffer_release(buffer);
+    return bitmap;
+}
+
+sk_sp<Bitmap> RenderThread::wrapHardwareBuffer(AHardwareBuffer* buffer,
+                                               sk_sp<SkColorSpace> colorSpace) {
+    if (!mGrContext || !buffer) return nullptr;
+    sk_sp<SkImage> image = artzig::makeHardwareBufferImage(mGrContext.get(), buffer,
+                                                           std::move(colorSpace));
+    return Bitmap::createFrom(buffer, std::move(image), BitmapPalette::Unknown);
 }
 
 bool RenderThread::isCurrent() {
