diff --git a/libs/hwui/renderthread/RenderProxy.cpp b/libs/hwui/renderthread/RenderProxy.cpp
index 3441bd5ce..cd638d87a 100644
--- a/libs/hwui/renderthread/RenderProxy.cpp
+++ b/libs/hwui/renderthread/RenderProxy.cpp
@@ -99,7 +99,7 @@ void RenderProxy::setName(const char* name) {
 }
 
 void RenderProxy::setHardwareBuffer(AHardwareBuffer* buffer) {
-#ifdef __ANDROID__
+#if defined(__ANDROID__) || defined(ARTZIG_HOST_GPU)
     if (buffer) {
         AHardwareBuffer_acquire(buffer);
     }
@@ -518,6 +518,21 @@ sk_sp<Bitmap> RenderProxy::allocateHardwareBitmap(const SkBitmap& bitmap) {
     return thread.queue().runSync(
             [&thread, source]() mutable { return thread.allocateHardwareBitmap(source); });
 }
+
+sk_sp<Bitmap> RenderProxy::wrapHardwareBuffer(AHardwareBuffer* buffer,
+                                              sk_sp<SkColorSpace> colorSpace) {
+    RenderThread& thread = RenderThread::getInstance();
+    if (RenderThread::isCurrent()) {
+        return thread.wrapHardwareBuffer(buffer, std::move(colorSpace));
+    }
+    AHardwareBuffer_acquire(buffer);
+    sk_sp<Bitmap> result = thread.queue().runSync(
+            [&thread, buffer, colorSpace = std::move(colorSpace)]() mutable {
+                return thread.wrapHardwareBuffer(buffer, std::move(colorSpace));
+            });
+    AHardwareBuffer_release(buffer);
+    return result;
+}
 #endif
 
