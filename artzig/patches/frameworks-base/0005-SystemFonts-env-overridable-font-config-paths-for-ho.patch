From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Mon, 24 Aug 2026 03:10:27 +0200
Subject: [PATCH 05/14] SystemFonts: env-overridable font config paths for host

ARTZIG_FONT_FALLBACK_XML / ARTZIG_FONTS_XML / ARTZIG_FONT_DIR redirect the
hardcoded /system/etc + /system/fonts paths so a host font set can be used.
---
 .../java/android/graphics/fonts/SystemFonts.java    | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/graphics/java/android/graphics/fonts/SystemFonts.java b/graphics/java/android/graphics/fonts/SystemFonts.java
index 599c42659..620887c1e 100644
--- a/graphics/java/android/graphics/fonts/SystemFonts.java
+++ b/graphics/java/android/graphics/fonts/SystemFonts.java
@@ -56,12 +56,19 @@ import java.util.Set;
 public final class SystemFonts {
     private static final String TAG = "SystemFonts";
 
-    private static final String FONTS_XML = getFontsXmlDir() + "font_fallback.xml";
+    private static final String FONTS_XML =
+            envOr("ARTZIG_FONT_FALLBACK_XML", getFontsXmlDir() + "font_fallback.xml");
     /** @hide */
-    public static final String LEGACY_FONTS_XML = getFontsXmlDir() + "fonts.xml";
+    public static final String LEGACY_FONTS_XML = envOr("ARTZIG_FONTS_XML", getFontsXmlDir() + "fonts.xml");
 
     /** @hide */
-    public static final String SYSTEM_FONT_DIR = getSystemFontDir();
+    public static final String SYSTEM_FONT_DIR = envOr("ARTZIG_FONT_DIR", getSystemFontDir());
+
+    /** artzig: host-path redirection for the font configuration. */
+    private static String envOr(String key, String def) {
+        String v = System.getenv(key);
+        return v != null ? v : def;
+    }
     private static final String OEM_XML = "/product/etc/fonts_customization.xml";
     /** @hide */
     public static final String OEM_FONT_DIR = "/product/fonts/";
