+    virtual void drainPendingEvents() override {
+        AChoreographer_handlePendingEvents(mRenderThread->mChoreographer, mRenderThread);
+    }
+
+private:
+    RenderThread* mRenderThread;
+};
+
+class DummyVsyncSource : public VsyncSource {
+public:
