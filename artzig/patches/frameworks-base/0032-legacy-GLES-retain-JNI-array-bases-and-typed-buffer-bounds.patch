From: Androlinzberg maintainers
Subject: [PATCH] legacy GLES: retain JNI array bases and typed buffer bounds

The pinned GLImpl JNI offsets heap-backed NIO pointers before passing them to
GL. Release the original array base, guard failed/unperformed acquisitions,
and compare typed buffer capacity in elements. This follows the native fixes
already used for GLES20/30/31/32; the Java API remains verbatim AOSP.

--- a/core/jni/com_google_android_gles_jni_GLImpl.cpp
+++ b/core/jni/com_google_android_gles_jni_GLImpl.cpp
@@ -410,6 +410,7 @@
     data = (GLvoid *)getPointer(_env, data_buf, (jarray*)&_array, &_remaining, &_bufferOffset);
     if (data == NULL) {
         char * _dataBase = (char *)_env->GetPrimitiveArrayCritical(_array, (jboolean *) 0);
+        if (_dataBase == nullptr) goto exit;
         data = (GLvoid *) (_dataBase + _bufferOffset);
     }
     glCompressedTexImage2D(
@@ -424,7 +425,7 @@
     );
 
 exit:
-    if (_array) {
+    if (_array && data) {
