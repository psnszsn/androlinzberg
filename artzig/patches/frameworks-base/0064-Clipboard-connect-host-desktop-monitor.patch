From: Androlinzberg host integration
Subject: [PATCH] Clipboard: connect stock access policy to the desktop monitor

--- a/services/core/java/com/android/server/clipboard/ClipboardService.java
+++ b/services/core/java/com/android/server/clipboard/ClipboardService.java
@@ -210,7 +210,20 @@
         mAutofillInternal = LocalServices.getService(AutofillManagerInternal.class);
         final IBinder permOwner = mUgmInternal.newUriPermissionOwner("clipboard");
         mPermissionOwner = permOwner;
-        if (Build.IS_EMULATOR) {
+        if (dev.artzig.system.HostedClipboardMonitor.isEnabled()) {
+            mClipboardMonitor = new dev.artzig.system.HostedClipboardMonitor(getContext(), (token, clip, sourceUid) -> {
+                synchronized (mLock) {
+                    if (!dev.artzig.system.HostedClipboardMonitor.isCurrentImport(token)) {
+                        return;
+                    }
+                    Clipboard clipboard = getClipboardLocked(0, DEVICE_ID_DEFAULT);
+                    if (clipboard != null) {
+                        setPrimaryClipInternalLocked(clipboard, clip, sourceUid,
+                                null);
+                    }
+                }
+            });
+        } else if (Build.IS_EMULATOR) {
             mClipboardMonitor = new EmulatorClipboardMonitor((clip) -> {
                 synchronized (mLock) {
                     Clipboard clipboard = getClipboardLocked(0, DEVICE_ID_DEFAULT);
@@ -936,5 +949,10 @@
     private void setPrimaryClipInternalLocked(
             @Nullable ClipData clip, int uid, int deviceId, @Nullable String sourcePackage) {
         if (deviceId == DEVICE_ID_DEFAULT) {
-            mClipboardMonitor.accept(clip);
+            if (mClipboardMonitor instanceof dev.artzig.system.HostedClipboardMonitor) {
+                ((dev.artzig.system.HostedClipboardMonitor) mClipboardMonitor)
+                        .acceptFromAndroid(clip, uid);
+            } else {
+                mClipboardMonitor.accept(clip);
+            }
         }
