From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Sun, 23 Aug 2026 19:16:27 +0200
Subject: [PATCH] libcore: host-embedding tweaks (no loadLibrary logE; virtual
 /system/lib* files)

Ported from art_standalone 1c5b26e4 and 5bda8706. Runtime.load/loadLibrary(String,
ClassLoader) are what an embedding host uses deliberately, so drop the logE. File.exists()
reports the bionic system libraries the host provides virtually as present.
---
 ojluni/src/main/java/java/io/File.java      | 17 +++++++++++++++++
 ojluni/src/main/java/java/lang/Runtime.java |  6 ++----
 2 files changed, 19 insertions(+), 4 deletions(-)

diff --git a/ojluni/src/main/java/java/io/File.java b/ojluni/src/main/java/java/io/File.java
index 3b921a3..1e2ac2c 100644
--- a/ojluni/src/main/java/java/io/File.java
+++ b/ojluni/src/main/java/java/io/File.java
@@ -816,6 +816,20 @@ public class File
      *          java.lang.SecurityManager#checkRead(java.lang.String)}</code>
      *          method denies read access to the file or directory
      */
+    // artzig: libraries that are provided by the host (bionic_translation / the
+    // embedding application) rather than by files on disk. Some apps (e.g. via
+    // Facebook's SoLoader) resolve native library dependencies themselves and
+    // check for these paths before calling System.loadLibrary.
+    private static final java.util.Set<String> ARTZIG_VIRTUAL_SYSTEM_LIBS = java.util.Set.of(
+        "/system/lib/libdl.so", "/system/lib64/libdl.so",
+        "/system/lib/libc.so", "/system/lib64/libc.so",
+        "/system/lib/libm.so", "/system/lib64/libm.so",
+        "/system/lib/liblog.so", "/system/lib64/liblog.so",
+        "/system/lib/libz.so", "/system/lib64/libz.so",
+        "/system/lib/libjnigraphics.so", "/system/lib64/libjnigraphics.so",
+        "/system/lib/libGLESv2.so", "/system/lib64/libGLESv2.so",
+        "/system/lib/libOpenSLES.so", "/system/lib64/libOpenSLES.so");
+
     public boolean exists() {
         SecurityManager security = System.getSecurityManager();
         if (security != null) {
@@ -824,6 +838,9 @@ public class File
         if (isInvalid()) {
             return false;
         }
+        if (ARTZIG_VIRTUAL_SYSTEM_LIBS.contains(path)) {
+            return true;
+        }
 
         // Android-changed: b/25878034 work around SELinux stat64 denial.
         return fs.checkAccess(this, FileSystem.ACCESS_OK);
diff --git a/ojluni/src/main/java/java/lang/Runtime.java b/ojluni/src/main/java/java/lang/Runtime.java
index 90a0656..4d6c57e 100644
--- a/ojluni/src/main/java/java/lang/Runtime.java
+++ b/ojluni/src/main/java/java/lang/Runtime.java
@@ -906,8 +906,7 @@ public class Runtime {
     void load(String absolutePath, ClassLoader loader) {
         checkTargetSdkVersionForLoad("java.lang.Runtime#load(String, ClassLoader)");
 
-        java.lang.System.logE("java.lang.Runtime#load(String, ClassLoader)" +
-                              " is private and will be removed in a future Android release");
+        // artzig: hosts embedding the runtime call this on purpose; don't spam logE.
         if (absolutePath == null) {
             throw new NullPointerException("absolutePath == null");
         }
@@ -1024,8 +1023,7 @@ public class Runtime {
      */
     public void loadLibrary(String libname, ClassLoader classLoader) {
         checkTargetSdkVersionForLoad("java.lang.Runtime#loadLibrary(String, ClassLoader)");
-        java.lang.System.logE("java.lang.Runtime#loadLibrary(String, ClassLoader)" +
-                              " is private and will be removed in a future Android release");
+        // artzig: hosts embedding the runtime call this on purpose; don't spam logE.
         // Pass null for callerClass, we don't know it at this point. Passing null preserved
         // the behavior when we used to not pass the class.
         loadLibrary0(classLoader, null, libname);
