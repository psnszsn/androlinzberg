Subject: [PATCH] Register host-linked original media extractors

The hosted extractor service uses linked plugins and initialized factory
ownership rather than Android's dedicated extractor daemon UID.

--- a/media/libstagefright/MediaExtractorFactory.cpp
+++ b/media/libstagefright/MediaExtractorFactory.cpp
@@ -38,6 +38,18 @@
 #include <dlfcn.h>
 
 namespace android {
+
+// Hosted packaging: original plugin entry points share one ELF. Keep AOSP
+// registration, confidence selection and plugin ownership.
+extern "C" ExtractorDef azk_wav_extractor_def();
+extern "C" ExtractorDef azk_mp3_extractor_def();
+extern "C" ExtractorDef azk_aac_extractor_def();
+extern "C" ExtractorDef azk_mp4_extractor_def();
+extern "C" ExtractorDef azk_mkv_extractor_def();
+extern "C" ExtractorDef azk_ogg_extractor_def();
+extern "C" ExtractorDef azk_flac_extractor_def();
+extern "C" ExtractorDef azk_amr_extractor_def();
+extern "C" ExtractorDef azk_mpeg2_extractor_def();
 
 // static
 sp<IMediaExtractor> MediaExtractorFactory::Create(
@@ -285,6 +297,11 @@
 
     std::shared_ptr<std::list<sp<ExtractorPlugin>>> newList(new std::list<sp<ExtractorPlugin>>());
 
+    for (auto getDef : {azk_wav_extractor_def, azk_mp3_extractor_def, azk_aac_extractor_def, azk_mp4_extractor_def, azk_mkv_extractor_def, azk_ogg_extractor_def, azk_flac_extractor_def, azk_amr_extractor_def, azk_mpeg2_extractor_def}) {
+        String8 path("host-linked AOSP extractor");
+        RegisterExtractor(new ExtractorPlugin(getDef(), nullptr, path), *newList);
+    }
+
     android_namespace_t *mediaNs = android_get_exported_namespace("com_android_media");
     if (mediaNs != NULL) {
         const android_dlextinfo dlextinfo = {
@@ -333,7 +350,8 @@
 
 // static
 std::vector<std::string> MediaExtractorFactory::getSupportedTypes() {
-    if (getuid() == AID_MEDIA_EX) {
+    // Factory ownership replaces the Android extractor daemon UID on this host.
+    if (gPluginsRegistered) {
         return gSupportedExtensions;
     }
     ALOGV("get service manager");
