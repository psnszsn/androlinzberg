From: artzig <artzig@localhost>
Subject: [PATCH] Looper: expose borrowed readiness descriptor to host event loop

The hosted event loop must wake for Java and NDK callbacks on the same looper.
Expose readiness without transferring descriptor ownership or consuming events.

--- a/include/utils/Looper.h
+++ b/include/utils/Looper.h
@@ -439,6 +439,12 @@
      */
     static sp<Looper> getForThread();
 
+#ifndef __ANDROID__
+    // Borrowed descriptor for an embedding event loop. Only query on this
+    // looper's thread; pollOnce remains responsible for consuming events.
+    int getPollFdForHost() const { return mEpollFd.get(); }
+#endif
+
 private:
   using SequenceNumber = uint64_t;
 
