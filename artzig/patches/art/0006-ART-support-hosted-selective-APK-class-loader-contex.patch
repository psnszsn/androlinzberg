From: artzig host adaptation <artzig@localhost>
Subject: ART: validate the implementation archive behind the platform API view

The APK compiler sees only the public platform namespace. Runtime framework
classes retain their full implementation loader. Follow the facade's backing
loader for dependency freshness without changing Java lookup dispatch. Retain
the stored runtime archive checksum when compiling against its API projection.

diff --git a/dex2oat/dex2oat.cc b/dex2oat/dex2oat.cc
--- a/dex2oat/dex2oat.cc
+++ b/dex2oat/dex2oat.cc
@@ -1670,6 +1670,16 @@
         LOG(WARNING) << "Failed to open classpath dex files";
       }
 
+      // artzig host adaptation: APK compilation uses a framework view with
+      // private libraries removed to match HostedPlatformClassLoader's API view,
+      // while the stored context names the full runtime framework.jar. Unlike
+      // Android's cross-product dexpreopt target paths, that runtime path exists
+      // while compiling on the host, so record its checksum when available.
+      if (stored_class_loader_context_ != nullptr &&
+          !stored_class_loader_context_->OpenDexFiles(classpath_dir_)) {
+        LOG(WARNING) << "Failed to open stored classpath dex files";
+      }
+
       // Store the class loader context in the oat header.
       // TODO: deprecate this since store_class_loader_context should be enough to cover the users
       // of classpath_dir as well.
diff --git a/runtime/class_loader_context.cc b/runtime/class_loader_context.cc
--- a/runtime/class_loader_context.cc
+++ b/runtime/class_loader_context.cc
@@ -717,7 +717,12 @@
 
     // dex2oat does not need the checksums.
     if (!for_dex2oat) {
-      checksums.push_back(info.checksums[i]);
+      // artzig host adaptation: when dex2oat can open the remapped stored
+      // context, validate the artifact against that runtime file rather than
+      // the compiler-only context used for the public platform API projection.
+      checksums.push_back(stored_info != nullptr && !stored_info->checksums.empty()
+                              ? stored_info->checksums[i]
+                              : info.checksums[i]);
     }
   }
   EncodeClassPath(base_dir, locations, checksums, info.type, out);
@@ -1111,6 +1116,28 @@
     return true;
   }
 
+  if (class_loader->GetClass()->DescriptorEquals(
+          "Ldev/artzig/HostedPlatformClassLoader;")) {
+    // The facade defines no classes. Its implementation archive is the physical
+    // dependency whose checksum must match the APK's stored compiler context.
+    // Java dispatch still owns the facade's namespace filtering at runtime.
+    ArtField* field = class_loader->GetClass()->FindDeclaredInstanceField(
+        "implementation", "Ljava/lang/ClassLoader;");
+    if (field == nullptr) {
+      LOG(ERROR) << "Hosted platform loader has no implementation field";
+      return false;
+    }
+    ObjPtr<mirror::Object> implementation = field->GetObject(class_loader.Get());
+    if (implementation == nullptr) {
+      LOG(ERROR) << "Hosted platform loader has no implementation loader";
+      return false;
+    }
+    StackHandleScope<1> hs(soa.Self());
+    Handle<mirror::ClassLoader> delegate = hs.NewHandle(implementation->AsClassLoader());
+    return CreateInfoFromClassLoader(
+        soa, delegate, dex_elements, child_info, is_shared_library, is_after);
+  }
+
   ClassLoaderContext::ClassLoaderType type;
   if (IsPathOrDexClassLoader(class_loader)) {
     type = kPathClassLoader;
