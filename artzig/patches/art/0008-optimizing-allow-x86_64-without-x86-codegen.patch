From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vlad Panazan <git@praznet.com>
Date: Wed, 2 Sep 2026 10:00:00 +0200
Subject: [PATCH 8/8] optimizing: allow x86_64 without x86 codegen

nodes_x86.h is shared by the x86 and x86_64 backends, but it defines the four
x86-only PC-relative instruction classes even when ART_ENABLE_CODEGEN_x86 is
disabled. Their instruction kinds are correctly omitted by nodes.h in that
configuration, so a pure x86_64 compiler fails to compile the class bodies.

The x86 memory operand generation pass is also shared and is part of the
x86_64 default optimization pipeline, but its construction and name lookup
are incorrectly guarded by ART_ENABLE_CODEGEN_x86. Keep that shared pass
available when either backend is enabled, and expose the x86_64 simplifier to
the pass-name lookup alongside the other architecture-specific passes.

Keep the genuinely shared BMI instruction nodes available to both backends and
guard the x86-only classes consistently with their instruction-kind list.
---
 compiler/optimizing/nodes_x86.h    |  8 ++++++++
 compiler/optimizing/optimization.cc | 17 ++++++++++++-----
 2 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/compiler/optimizing/nodes_x86.h b/compiler/optimizing/nodes_x86.h
index 4ce5a77..a9c8e6b 100644
--- a/compiler/optimizing/nodes_x86.h
+++ b/compiler/optimizing/nodes_x86.h
@@ -19,6 +19,12 @@
 
 namespace art HIDDEN {
 
+// Artzig's x86_64-only configuration does not build CodeGeneratorX86. These
+// classes correspond to FOR_EACH_CONCRETE_INSTRUCTION_X86() in nodes.h and are
+// used only by the 32-bit x86 PC-relative fixups and code generator. Upstream
+// ART normally enables x86 alongside x86_64, so it does not guard the class
+// definitions separately.
+#ifdef ART_ENABLE_CODEGEN_x86
 // Compute the address of the method for X86 Constant area support.
 class HX86ComputeBaseMethodAddress final : public HExpression<0> {
  public:
@@ -128,6 +134,8 @@ class HX86PackedSwitch final : public HExpression<2> {
   const int32_t num_entries_;
 };
 
+#endif  // ART_ENABLE_CODEGEN_x86
+
 class HX86AndNot final : public HBinaryOperation {
  public:
   HX86AndNot(DataType::Type result_type,
diff --git a/compiler/optimizing/optimization.cc b/compiler/optimizing/optimization.cc
--- a/compiler/optimizing/optimization.cc
+++ b/compiler/optimizing/optimization.cc
@@ -171,10 +171,15 @@ OptimizationPass OptimizationPassByName(const std::string& pass_name) {
 #ifdef ART_ENABLE_CODEGEN_riscv64
   X(OptimizationPass::kCriticalNativeAbiFixupRiscv64);
   X(OptimizationPass::kInstructionSimplifierRiscv64);
 #endif
 #ifdef ART_ENABLE_CODEGEN_x86
   X(OptimizationPass::kPcRelativeFixupsX86);
-  X(OptimizationPass::kX86MemoryOperandGeneration);
+#endif
+#ifdef ART_ENABLE_CODEGEN_x86_64
+  X(OptimizationPass::kInstructionSimplifierX86_64);
+#endif
+#if defined(ART_ENABLE_CODEGEN_x86) || defined(ART_ENABLE_CODEGEN_x86_64)
+  X(OptimizationPass::kX86MemoryOperandGeneration);
 #endif
   LOG(FATAL) << "Cannot find optimization " << pass_name;
   UNREACHABLE();
@@ -335,19 +340,21 @@ ArenaVector<HOptimization*> ConstructOptimizations(
       case OptimizationPass::kPcRelativeFixupsX86:
         DCHECK(alt_name == nullptr) << "arch-specific pass does not support alternative name";
         opt = new (allocator) x86::PcRelativeFixups(graph, codegen, stats);
         break;
-      case OptimizationPass::kX86MemoryOperandGeneration:
-        DCHECK(alt_name == nullptr) << "arch-specific pass does not support alternative name";
-        opt = new (allocator) x86::X86MemoryOperandGeneration(graph, codegen, stats);
-        break;
       case OptimizationPass::kInstructionSimplifierX86:
         opt = new (allocator) x86::InstructionSimplifierX86(graph, codegen, stats);
         break;
 #endif
 #ifdef ART_ENABLE_CODEGEN_x86_64
       case OptimizationPass::kInstructionSimplifierX86_64:
         opt = new (allocator) x86_64::InstructionSimplifierX86_64(graph, codegen, stats);
         break;
+#endif
+#if defined(ART_ENABLE_CODEGEN_x86) || defined(ART_ENABLE_CODEGEN_x86_64)
+      case OptimizationPass::kX86MemoryOperandGeneration:
+        DCHECK(alt_name == nullptr) << "arch-specific pass does not support alternative name";
+        opt = new (allocator) x86::X86MemoryOperandGeneration(graph, codegen, stats);
+        break;
 #endif
       case OptimizationPass::kNone:
         LOG(FATAL) << "kNone does not represent an actual pass";
