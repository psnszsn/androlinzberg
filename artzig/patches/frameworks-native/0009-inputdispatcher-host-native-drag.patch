+// Incoming native drags have no Android pointer DOWN to transfer. Reuse the
+// same SF hit test and input-channel DragEntry path as addDragEventLocked;
+// WM retains the drag lifecycle, recipient checks and URI permission policy.
+InputDispatcher::HostedDragTarget InputDispatcher::hostedDragTarget(
+        const sp<IBinder>& task, const sp<IBinder>& previous,
+        ui::LogicalDisplayId displayId, float x, float y, bool dispatchHover) {
+    HostedDragTarget result;
+    if (!task || !std::isfinite(x) || !std::isfinite(y)) return result;
+    // enqueueDragEventLocked follows the pinned integer input-coordinate API.
+    if (x < INT32_MIN || x >= INT32_MAX || y < INT32_MIN || y >= INT32_MAX) return result;
+    {
+        std::scoped_lock lock(mLock);
+        auto target = mWindowInfos.findTouchedWindowAt(displayId, x, y, false);
+        if (target) {
+            auto owner = mHostedWindowTasks.find(target->getToken());
+            if (owner == mHostedWindowTasks.end() || owner->second != task) target = nullptr;
+        }
+        if (dispatchHover) {
+            auto old = previous ? mWindowInfos.findWindowHandle(previous) : nullptr;
+            if (old && !haveSameToken(old, target)) enqueueDragEventLocked(old, true, x, y);
+            if (target) enqueueDragEventLocked(target, false, x, y);
+        }
+        if (target) {
+            const vec2 local = target->getInfo()->transform.transform(x, y);
+            result = {target->getToken(), local.x, local.y};
+        }
+    }
+    if (dispatchHover) mLooper->wake();
+    return result;
 }
 
