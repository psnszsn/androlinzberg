+bool InputDispatcher::hostedWindowAllowedLocked(const sp<WindowInfoHandle>& window) const {
+    if (!mHostedKeyboardEnabled) return true;
+    if (!mHostedKeyboardTask) return false;
+    auto task = mHostedWindowTasks.find(window->getToken());
+    return task != mHostedWindowTasks.end() && task->second == mHostedKeyboardTask;
+}
+
+bool InputDispatcher::hostedKeyCurrentLocked(const KeyEntry& key) const {
+    return !key.hostedScope || (mHostedKeyboardEnabled &&
+            key.hostedScope->task == mHostedKeyboardTask &&
+            key.hostedScope->epoch == mHostedKeyboardEpoch);
+}
+
+std::vector<sp<WindowInfoHandle>> InputDispatcher::hostedFocusWindowsLocked(
+        const std::vector<sp<WindowInfoHandle>>& windows) const {
+    if (!mHostedKeyboardEnabled) return windows;
+    std::vector<sp<WindowInfoHandle>> result;
+    for (const auto& window : windows) {
+        if (hostedWindowAllowedLocked(window)) result.push_back(window);
+    }
+    return result;
+}
+
+void InputDispatcher::setHostedKeyboardFocus(const sp<IBinder>& task) {
+    {
+        std::scoped_lock _l(mLock);
+        LOG_ALWAYS_FATAL_IF(mHostedKeyboardEpoch == UINT64_MAX, "Hosted keyboard epoch exhausted");
+        ++mHostedKeyboardEpoch;
+        mHostedKeyboardEnabled = true;
+        mHostedKeyboardTask = task;
+        resetKeyRepeatLocked();
+        ScopedSyntheticEventTracer traceContext(mTracer);
+        std::vector<ui::LogicalDisplayId> displays;
+        mWindowInfos.forEachDisplayId([&](ui::LogicalDisplayId id) { displays.push_back(id); });
+        for (const auto display : displays) {
+            const auto changes = mFocusResolver.setInputWindows(display,
+                    hostedFocusWindowsLocked(mWindowInfos.getWindowHandlesForDisplay(display)));
+            if (changes) onFocusChangedLocked(*changes, traceContext.getTracker());
+        }
+    }
+    mLooper->wake();
+}
