+void InputDispatcher::notifyHostedKey(const NotifyKeyArgs& args, const sp<IBinder>& task) {
+    std::optional<HostedKeyScope> scope;
+    {
+        std::scoped_lock _l(mLock);
+        if (!mHostedKeyboardEnabled || !task || task != mHostedKeyboardTask) return;
+        scope = HostedKeyScope{task, mHostedKeyboardEpoch};
+    }
+    // Capture before policy: focus may change while a policy callback runs.
+    notifyKey(args, scope);
+}
