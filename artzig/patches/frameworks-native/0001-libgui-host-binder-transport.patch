From: Androlinzberg maintainers
Subject: [PATCH] libgui: adapt host caller identity and gralloc boundaries

Pinned AOSP producer interfaces retain their original Binder/HIDL discovery.
BufferQueueThreadState uses authenticated AZKB caller identity.

Select host allocator/mapper factories at libui's Gralloc boundary. Retain the
stock GraphicBuffer validation, metadata, accounting and ownership above it;
the host backend owns GBM allocations and imported DMA-BUF descriptors.

--- a/libs/gui/BufferQueueThreadState.cpp
+++ b/libs/gui/BufferQueueThreadState.cpp
@@ -14,36 +14,11 @@
  * limitations under the License.
  */
 
-#ifndef NO_BINDER
+// Host adaptation of BufferQueueThreadState: AZKB has one Binder dispatch
+// domain and no HIDL Binder service. Preserve its authenticated caller identity.
 #include <binder/IPCThreadState.h>
-#include <binderthreadstate/CallerUtils.h>
-#endif // NO_BINDER
-#include <hwbinder/IPCThreadState.h>
 #include <private/gui/BufferQueueThreadState.h>
-#include <unistd.h>
-
 namespace android {
-
-uid_t BufferQueueThreadState::getCallingUid() {
-#ifndef NO_BINDER
-    if (getCurrentServingCall() == BinderCallType::HWBINDER) {
-        return hardware::IPCThreadState::self()->getCallingUid();
-    }
-    return IPCThreadState::self()->getCallingUid();
-#else // NO_BINDER
-    return hardware::IPCThreadState::self()->getCallingUid();
-#endif // NO_BINDER
+uid_t BufferQueueThreadState::getCallingUid() { return IPCThreadState::self()->getCallingUid(); }
+pid_t BufferQueueThreadState::getCallingPid() { return IPCThreadState::self()->getCallingPid(); }
 }
-
-pid_t BufferQueueThreadState::getCallingPid() {
-#ifndef NO_BINDER
-    if (getCurrentServingCall() == BinderCallType::HWBINDER) {
-        return hardware::IPCThreadState::self()->getCallingPid();
-    }
-    return IPCThreadState::self()->getCallingPid();
-#else // NO_BINDER
-    return hardware::IPCThreadState::self()->getCallingPid();
-#endif // NO_BINDER
-}
-
-} // namespace android
--- a/libs/ui/GraphicBufferMapper.cpp
+++ b/libs/ui/GraphicBufferMapper.cpp
@@ -33,10 +33,7 @@
 #include <utils/Trace.h>
 
 #include <ui/Gralloc.h>
-#include <ui/Gralloc2.h>
-#include <ui/Gralloc3.h>
-#include <ui/Gralloc4.h>
-#include <ui/Gralloc5.h>
+#include <azk/HostGralloc.h>
 #include <ui/GraphicBuffer.h>
 
 #include <system/graphics.h>
@@ -50,37 +47,10 @@
 
 ANDROID_SINGLETON_STATIC_INSTANCE( GraphicBufferMapper )
 
-void GraphicBufferMapper::preloadHal() {
-    Gralloc2Mapper::preload();
-    Gralloc3Mapper::preload();
-    Gralloc4Mapper::preload();
-    Gralloc5Mapper::preload();
-}
-
-GraphicBufferMapper::GraphicBufferMapper() {
-    mMapper = std::make_unique<const Gralloc5Mapper>();
-    if (mMapper->isLoaded()) {
-        mMapperVersion = Version::GRALLOC_5;
-        return;
-    }
-    mMapper = std::make_unique<const Gralloc4Mapper>();
-    if (mMapper->isLoaded()) {
-        mMapperVersion = Version::GRALLOC_4;
-        return;
-    }
-    mMapper = std::make_unique<const Gralloc3Mapper>();
-    if (mMapper->isLoaded()) {
-        mMapperVersion = Version::GRALLOC_3;
-        return;
-    }
-    mMapper = std::make_unique<const Gralloc2Mapper>();
-    if (mMapper->isLoaded()) {
-        mMapperVersion = Version::GRALLOC_2;
-        return;
-    }
-
-    LOG_ALWAYS_FATAL("gralloc-mapper is missing");
-}
+// Host backend selection; the remaining mapper contracts are pinned AOSP.
+void GraphicBufferMapper::preloadHal() {}
+GraphicBufferMapper::GraphicBufferMapper() : mMapper(azk::createGrallocMapper()),
+    mMapperVersion(Version::GRALLOC_4) {}
 
 void GraphicBufferMapper::dumpBuffer(buffer_handle_t bufferHandle, std::string& result,
                                      bool less) const {
--- a/libs/ui/GraphicBufferAllocator.cpp
