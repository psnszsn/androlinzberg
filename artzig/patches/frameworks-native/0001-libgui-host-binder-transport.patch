+// Host adaptation of BufferQueueThreadState: AZKB has one Binder dispatch
+// domain and no HIDL Binder service. Preserve its authenticated caller identity.
 #include <binder/IPCThreadState.h>
-#include <binderthreadstate/CallerUtils.h>
-#endif // NO_BINDER
-#include <hwbinder/IPCThreadState.h>
 #include <private/gui/BufferQueueThreadState.h>
-#include <unistd.h>
