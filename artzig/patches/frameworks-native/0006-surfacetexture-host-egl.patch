From: Androlinzberg maintainers
Subject: [PATCH] SurfaceTexture: import host DMA-BUF images

Use the same device, image import and balanced EGL display ownership as stock
GLConsumer. BufferQueue, texture transforms, frame callbacks and fences remain
pinned AOSP behavior. Protected allocations remain rejected by the mapper.

--- a/libs/nativedisplay/surfacetexture/EGLConsumer.cpp
+++ b/libs/nativedisplay/surfacetexture/EGLConsumer.cpp
@@ -18,6 +18,7 @@
 #define EGL_EGLEXT_PROTOTYPES
 
 #include <EGL/egl.h>
+#include <azk/graphics_egl.h>
 #include <EGL/eglext.h>
 #include <GLES2/gl2.h>
 #include <GLES2/gl2ext.h>
@@ -64,7 +65,7 @@
 sp<GraphicBuffer> EGLConsumer::sReleasedTexImageBuffer;
 
 static bool hasEglProtectedContentImpl() {
-    EGLDisplay dpy = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    EGLDisplay dpy = azk_graphics_egl_display();
     const char* exts = eglQueryString(dpy, EGL_EXTENSIONS);
     size_t cropExtLen = strlen(PROT_CONTENT_EXT_STR);
     size_t extsLen = strlen(exts);
@@ -623,7 +624,7 @@
         if (!eglDestroyImageKHR(mEglDisplay, mEglImage)) {
             ALOGE("~EglImage: eglDestroyImageKHR failed");
         }
-        eglTerminate(mEglDisplay);
+        azk_graphics_egl_terminate(mEglDisplay);
     }
 }
 
@@ -635,7 +636,7 @@
         if (!eglDestroyImageKHR(mEglDisplay, mEglImage)) {
             ALOGE("createIfNeeded: eglDestroyImageKHR failed");
         }
-        eglTerminate(mEglDisplay);
+        azk_graphics_egl_terminate(mEglDisplay);
         mEglImage = EGL_NO_IMAGE_KHR;
         mEglDisplay = EGL_NO_DISPLAY;
     }
@@ -665,23 +666,16 @@
 
 EGLImageKHR EGLConsumer::EglImage::createImage(EGLDisplay dpy,
                                                const sp<GraphicBuffer>& graphicBuffer) {
-    EGLClientBuffer cbuf = static_cast<EGLClientBuffer>(graphicBuffer->getNativeBuffer());
-    const bool createProtectedImage =
-            (graphicBuffer->getUsage() & GRALLOC_USAGE_PROTECTED) && hasEglProtectedContent();
-    EGLint attrs[] = {
-            EGL_IMAGE_PRESERVED_KHR,
-            EGL_TRUE,
-            createProtectedImage ? EGL_PROTECTED_CONTENT_EXT : EGL_NONE,
-            createProtectedImage ? EGL_TRUE : EGL_NONE,
-            EGL_NONE,
-    };
-    eglInitialize(dpy, nullptr, nullptr);
-    EGLImageKHR image =
-            eglCreateImageKHR(dpy, EGL_NO_CONTEXT, EGL_NATIVE_BUFFER_ANDROID, cbuf, attrs);
+    // Host seam: import the registered DMA-BUF layout through the shared mapper.
+    // Keep SurfaceTexture's acquisition, transforms, fences and image lifetime.
+    if (!azk_graphics_egl_initialize(dpy, nullptr, nullptr)) return EGL_NO_IMAGE_KHR;
+    EGLImageKHR image = EGL_NO_IMAGE_KHR;
+    const auto status = azk_graphics_import_egl_image(dpy, graphicBuffer->handle, &image);
+    if (status != OK) ALOGE("host EGLImage import failed: %d", status);
     if (image == EGL_NO_IMAGE_KHR) {
         EGLint error = eglGetError();
         ALOGE("error creating EGLImage: %#x", error);
-        eglTerminate(dpy);
+        azk_graphics_egl_terminate(dpy);
     }
     return image;
 }
