From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: artzig <artzig@localhost>
Date: Fri, 4 Sep 2026 23:12:59 +0000
Subject: [PATCH] WifiSsid: keep legacy unknown SSID without WifiManager

Device policy exposes WifiSsid as a value type, but WifiManager remains fenced
because the host has no supplicant or IWifiManager service. Preserve the exact
platform value of the legacy NONE constant without extending or replacing that
survivor.

diff --git a/framework/java/android/net/wifi/WifiSsid.java b/framework/java/android/net/wifi/WifiSsid.java
index ea90c74..244f53b 100644
--- a/framework/java/android/net/wifi/WifiSsid.java
+++ b/framework/java/android/net/wifi/WifiSsid.java
@@ -212,7 +212,9 @@ public final class WifiSsid implements Parcelable {
      */
     // TODO(b/231433398): add maxTargetSdk = Build.VERSION_CODES.S
     @UnsupportedAppUsage(publicAlternatives = "{@link android.net.wifi.WifiManager#UNKNOWN_SSID}")
-    public static final String NONE = WifiManager.UNKNOWN_SSID;
+    // Host adaptation (artzig): preserve the platform constant without pulling in or extending
+    // the fenced WifiManager survivor; no IWifiManager service exists on the host.
+    public static final String NONE = "<unknown ssid>";

     /**
      * Use {@link #fromBytes(byte[])} instead.
--
2.55.0
