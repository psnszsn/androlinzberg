#!/usr/bin/env bash
# Host-JDK Kotlin client for Androlinzberg's private test-control interface.
set -euo pipefail

LAUNCHER_DIR=$(dirname "$(realpath "$0")")
if [[ -f "$LAUNCHER_DIR/../lib/azk-test/testkit.jar" ]]; then
    DEFAULT_TESTKIT_ROOT=$(realpath "$LAUNCHER_DIR/../lib/azk-test")
else
    REPO_ROOT=$(dirname "$LAUNCHER_DIR")
    DEFAULT_TESTKIT_ROOT="$REPO_ROOT/zig-out/lib/azk-test"
fi
TESTKIT_ROOT=${AZK_TESTKIT_ROOT:-"$DEFAULT_TESTKIT_ROOT"}
if [[ ! -f "$TESTKIT_ROOT/testkit.jar" ]]; then
    echo "azk-test: Kotlin testkit is not built; run: zig build -j10 testkit" >&2
    exit 1
fi

MAIN=dev.artzig.testkit.AzkTestCli
if [[ ${1:-} == --junit ]]; then
    MAIN=dev.artzig.testkit.IntegrationTestMain
    shift
elif [[ ${1:-} == --unit ]]; then
    MAIN=dev.artzig.testkit.TestkitUnitTestMain
    shift
fi

exec java -cp "$TESTKIT_ROOT/*" "$MAIN" "$@"
