# Headless Android UI inspection and interaction for Androlinzberg.
interface dev.artzig.androlinzberg.test1

type Mark (
  epoch: string,
  command_seq: int,
  input_seq: int,
  tree_revision: int,
  log_seq: int,
  issue_seq: int,
  frame_seq: int,
  presented_frame_seq: int
)

type Selector (
  window: ?(active, all),
  task_id: ?int,
  window_id: ?int,
  pid: ?int,
  process_generation: ?int,
  resource_id: ?string,
  text: ?string,
  content_description: ?string,
  class_name: ?string,
  role: ?string,
  visible: ?bool,
  enabled: ?bool,
  focused: ?bool,
  index: ?int
)

type Action (
  kind: (click, long_click, focus, set_text, scroll_forward, scroll_backward,
         tap, drag, type_keys, key),
  via: (semantic, wayland),
  text: ?string,
  key: ?string,
  from_x_fraction: ?float,
  from_y_fraction: ?float,
  to_x_fraction: ?float,
  to_y_fraction: ?float
)

type Wait (
  kind: (now, ready, idle, exists, absent, tree_changed, frame_presented),
  after: ?Mark,
  stable_frames: ?int,
  timeout_ms: int
)

method Observe(selector: ?Selector, wait: Wait, include_tree: bool) ->
  (observation: object)

method Perform(selector: Selector, action: Action, settle: Wait) ->
  (result: object, observation: object)

method Diagnose(since: ?Mark) -> (diagnostics: object)

error NotReady ()
error NoMatch ()
error AmbiguousMatch (count: int)
error InactiveWindow ()
error UnsupportedAction (action: string)
error ActionRejected (action: string)
error InputUnavailable (reason: string)
error TreeTooLarge ()
error Timeout (applied: bool)
error AppExited ()
error InternalFailure (message: string)
