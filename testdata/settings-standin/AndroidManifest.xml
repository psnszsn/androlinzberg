<?xml version="1.0" encoding="utf-8"?>
<!-- Host stand-in for the Settings app's "Install unknown apps" screen
     (packages/apps/Settings ExternalSourcesDetails), the one Settings action
     the stock PackageInstaller sends a user to (InstallLaunch.sendUnknownAppsIntent).
     Replaced by the stock Settings app when it is built. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.artzig.settings"
    android:versionCode="1"
    android:versionName="hosted">

    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
    <!-- Settings lists and inspects every installed package. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application android:label="Settings" android:allowBackup="false">
        <activity android:name=".ManageUnknownAppSourcesActivity"
            android:label="Install unknown apps"
            android:exported="true">
            <intent-filter>
                <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="package" />
            </intent-filter>
        </activity>
    </application>
</manifest>
