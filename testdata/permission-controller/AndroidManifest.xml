<?xml version="1.0" encoding="utf-8"?>
<!-- Host stand-in for the permission module's PermissionController APK
     (packages/modules/Permission/PermissionController). Pinned
     PackageManagerService.getRequiredPermissionControllerLPr requires exactly one
     privileged system activity for ACTION_MANAGE_PERMISSIONS; stock
     ActivityStarter/PackageManager route runtime permission requests to this
     package. The interactive grant UI of the real module is not built here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.permissioncontroller"
    android:versionCode="1"
    android:versionName="hosted"
    coreApp="true">

    <uses-permission android:name="android.permission.GET_RUNTIME_PERMISSIONS" />
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />

    <application android:label="Permission controller"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:allowBackup="false">

        <!-- Stock RoleControllerManager resolves this even when the Android 16
             system-server controller is selected. Both use the stock class. -->
        <service android:name="com.android.role.controller.service.RoleControllerServiceImpl"
            android:exported="true">
            <intent-filter android:priority="1">
                <action android:name="android.app.role.RoleControllerService" />
            </intent-filter>
        </service>

        <!-- PermissionController GrantPermissionsActivity contract. -->
        <activity android:name="dev.artzig.permissioncontroller.GrantPermissionsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:priority="1">
                <action android:name="android.content.pm.action.REQUEST_PERMISSIONS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- PermissionControllerService: the system's delegate for default grants,
             revocation and backup (PermissionControllerManager binds it). -->
        <service android:name="dev.artzig.permissioncontroller.HostedPermissionControllerService"
            android:exported="true"
            android:permission="android.permission.BIND_PERMISSION_CONTROLLER">
            <intent-filter>
                <action android:name="android.permission.PermissionControllerService" />
            </intent-filter>
        </service>

        <!-- ManagePermissionsActivity: the permission-management entry point PMS resolves. -->
        <activity android:name="dev.artzig.permissioncontroller.ManagePermissionsActivity"
            android:exported="true"
            android:permission="android.permission.GRANT_RUNTIME_PERMISSIONS"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MANAGE_PERMISSIONS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
