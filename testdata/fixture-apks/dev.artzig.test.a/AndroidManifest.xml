<?xml version="1.0" encoding="utf-8"?>
<!-- system-test peer A: client permissions and service, activity, and provider
     fixtures. Signature permissions share the framework-res.apk test key. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.artzig.test.a"
    android:versionCode="1"
    android:versionName="1">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Telephony/telecom checks: the privileged phone-state permission (signature,
         granted for the same reason) and the normal self-managed-calls permission. -->
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Dropbox reads (signature|privileged|development). -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- Sensor-less biometric service contracts, including privileged sensor metadata. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC_INTERNAL" />
    <uses-feature android:name="android.software.companion_device_setup" android:required="false" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_SELF_MANAGED" />
    <uses-permission android:name="android.permission.MANAGE_COMPANION_DEVICES" />
    <uses-permission android:name="android.permission.REQUEST_NETWORK_SCORES" />
    <uses-permission android:name="android.permission.SCORE_NETWORKS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:name="dev.artzig.systemtest.BindingApplication" android:hasCode="false" android:label="azk test a">
        <provider android:name="dev.artzig.systemtest.SecretProvider"
            android:authorities="dev.artzig.test.a.secret" android:exported="false"
            android:grantUriPermissions="true" />
        <activity android:name="dev.artzig.systemtest.AUriGrantActivity" android:exported="true" />
        <service android:name="dev.artzig.systemtest.TestNetworkRecommendationService" android:exported="true">
            <intent-filter>
                <action android:name="android.net.action.RECOMMEND_NETWORKS" />
            </intent-filter>
        </service>
        <!-- Resolvable only while enabled; the client toggles it to check the
             explicit-lookup enabled-state gate (no code needed for a manifest
             lookup). -->
        <activity android:name="dev.artzig.systemtest.AToggleActivity"
            android:exported="true" />
        <!-- Job services for the hosted job scheduler: one valid, one that lacks
             the BIND_JOB_SERVICE permission the scheduler requires. -->
        <service android:name="dev.artzig.systemtest.AJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <service android:name="dev.artzig.systemtest.ANoPermissionJobService"
            android:exported="false" />
        <!-- A self-managed ConnectionService for the telecom phone-account checks:
             registration requires the service to hold the telecom bind permission. -->
        <service android:name="dev.artzig.systemtest.ATestConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true" />
    </application>
</manifest>
