<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.artzig.fixtures.windows" android:versionCode="1" android:versionName="1">
    <!-- This platform-signed fixture also drives the stock server gate before
         a desktop launcher owns initial task starts. It uses Android's explicit
         background-start permission; ordinary APK launch belongs to the task shell. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Window contracts" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".WindowFixtureActivity" android:exported="true" android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".TextureFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".FrameFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".FrameCoverActivity" android:resizeableActivity="true" />
        <activity android:name=".LayoutFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".SurfaceLifecycleFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".AccessibilityFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".WindowRegistryFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".InputRoutingFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".InspectionFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".VideoFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".ImeFixtureActivity" android:resizeableActivity="true" />
        <provider android:name=".ClipboardFileProvider" android:exported="false" android:grantUriPermissions="true"
            android:authorities="dev.artzig.fixtures.windows.clipboard" />
        <activity android:name=".DragFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".ClipboardFixtureActivity" android:resizeableActivity="true" />
        <activity android:name=".ColdProcessActivity" android:process=":cold" android:resizeableActivity="true" />
        <activity android:name=".ColdGroupedActivity" android:process=":cold" android:resizeableActivity="true" />
        <activity android:name=".ColdHandledConfigurationActivity" android:process=":cold"
            android:resizeableActivity="true" android:configChanges="grammaticalGender|uiMode" />
        <provider android:name=".ColdProcessProvider" android:process=":cold" android:exported="false"
            android:authorities="dev.artzig.fixtures.windows.cold" />
        <service android:name=".ColdProcessService" android:process=":cold" android:exported="false" />
        <provider android:name=".ProviderOnlyProcess" android:process=":provider" android:exported="false"
            android:authorities="dev.artzig.fixtures.windows.provider" />
        <provider android:name=".FailingStartupProvider" android:process=":retry" android:exported="false"
            android:authorities="dev.artzig.fixtures.windows.retry" />
        <service android:name=".RetryProcessService" android:process=":retry" android:exported="false" />
        <activity android:name=".SecondActivity" android:resizeableActivity="true" />
        <activity android:name=".IndependentTaskActivity" android:resizeableActivity="true"
            android:taskAffinity="dev.artzig.fixtures.windows.independent" />
        <activity android:name=".HandledResizeActivity" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density" />
    </application>
</manifest>
