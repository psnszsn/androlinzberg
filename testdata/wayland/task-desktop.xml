<?xml version="1.0"?>
<labwc_config>
  <keyboard>
    <default />
    <keybind key="F9"><action name="ToggleShowDesktop" /></keybind>
  </keyboard>
  <focus><followMouse>no</followMouse></focus>
  <windowRules>
    <windowRule identifier="dev.artzig.fixtures.windows" serverDecoration="no" />
    <windowRule identifier="dev.artzig.fixtures.windows" title="Cyan task">
      <action name="ResizeTo" width="440" height="300" />
      <action name="MoveTo" x="30" y="30" />
    </windowRule>
    <windowRule identifier="dev.artzig.fixtures.windows" title="Magenta task">
      <action name="ResizeTo" width="440" height="300" />
      <action name="MoveTo" x="500" y="100" />
    </windowRule>
  </windowRules>
</labwc_config>
