+static struct wlr_data_device_manager *azk_clipboard_manager;
+
+/* Keep existing resources until display teardown while the test replaces
+ * the advertised manager. The normal compositor still owns selection state. */
+void
+azk_clipboard_command(const char *title)
+{
+    static bool removed;
+    if (!getenv("AZK_TEST_CLIPBOARD") || !title) {
+        return;
+    }
+    if (!strcmp(title, "AZK CLIPBOARD:remove") && !removed) {
+        wl_global_remove(azk_clipboard_manager->global);
+        removed = true;
+    } else if (!strcmp(title, "AZK CLIPBOARD:restore") && removed) {
+        azk_clipboard_manager = wlr_data_device_manager_create(server.wl_display);
+        assert(azk_clipboard_manager);
+        removed = false;
+    }
+}
