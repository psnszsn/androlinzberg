+/* Test-only input method source. The normal relay continues to own focus;
+ * commands use public task metadata and real text-input-v3 wire events. */
+void
+azk_ime_command(struct input_method_relay *relay, struct wlr_surface *surface,
+        const char *title)
+{
+    static uint32_t old_editor_serial;
+    if (!getenv("AZK_TEST_IME") || !title || strncmp(title, "AZK IME:", 8)) return;
+    struct text_input *entry;
+    wl_list_for_each(entry, &relay->text_inputs, link) {
+        struct wlr_text_input_v3 *input = entry->input;
+        if (input->focused_surface != surface || !input->current_enabled) continue;
+        const char *command = title + 8;
+        if (!strcmp(command, "preedit") || !strcmp(command, "leave-preedit")) {
+            wlr_text_input_v3_send_preedit_string(input, "é拼", 2, 2);
+            old_editor_serial = input->current_serial;
+        } else if (!strcmp(command, "hidden")) {
+            wlr_text_input_v3_send_preedit_string(input, "候", -1, -1);
+        } else if (!strcmp(command, "commit")) {
+            wlr_text_input_v3_send_commit_string(input, "文");
+            /* The older done still carries valid edits for this editor. */
+            input->current_serial--;
+            wlr_text_input_v3_send_done(input);
+            input->current_serial++;
+        } else if (!strcmp(command, "delete")) {
+            wlr_text_input_v3_send_delete_surrounding_text(input, 3, 3);
+            wlr_text_input_v3_send_commit_string(input, "é");
+        } else if (!strcmp(command, "password")) {
+            assert(!(input->current.features & WLR_TEXT_INPUT_V3_FEATURE_SURROUNDING_TEXT));
+            assert(input->current.content_type.hint & 0x80);
+            assert(input->current.content_type.purpose == 8);
+            /* A superseded editor must not acquire this password target. */
+            uint32_t serial = input->current_serial;
+            input->current_serial = old_editor_serial;
+            wlr_text_input_v3_send_commit_string(input, "MUST_NOT_INSERT");
+            wlr_text_input_v3_send_done(input);
+            input->current_serial = serial;
+            wlr_text_input_v3_send_commit_string(input, "✓");
+        } else return;
+        wlr_text_input_v3_send_done(input);
+        return;
+    }
+}
